/*************************************************************************
 * Copyright (c) 2025, ENFLAME CORPORATION. All rights reserved.
 *
 * FlagCX Device API test kernels — Enflame (TOPS) backend.
 *
 * Signature-compatible with test/kernel/nvidia/device_api.cu (and
 * test/kernel/du/device_api.cu): same kernel/launcher names, same parameters,
 * same order, so test/kernel/include/device_api.h and the harness under
 * test/unittest/device_api/ link unchanged.
 *
 * Port status: the inter-node Net kernels used by tests K1-K4
 * (DevNetGetFromComm, Reset, PutSignalInc, PutSignalAdd) and the shared
 * ipcAlltoAll helper are implemented, ported from the nvidia bodies. The
 * remaining entry points are still stubs that return immediately, each
 * carrying a TODO.
 *
 * Porting notes for this platform:
 *   - Kernel launch syntax is the nvcc-style <<<grid, block, shmem, stream>>>,
 *     but the stream type is topsStream_t, not cudaStream_t, so launchers must
 *     do `topsStream_t ts = *(topsStream_t *)stream;`.
 *   - Report errors with topsGetLastError()/topsSuccess instead of
 *     cudaGetLastError()/cudaSuccess.
 *   - CommTraits on this platform is the ECCL one
 *     (flagcx/adaptor/include/device_api/eccl_comm_traits.h), selected by
 *     -DFLAGCX_COMM_TRAITS_CCL.
 *
 * Host-side flagcxDevCommCreate/Destroy are in flagcx_device.cc.
 ************************************************************************/

#include "device_api/flagcx_device.h"
#include "enflame_adaptor.h"
#include "global_comm.h"
#include "flagcx_kernel.h"
#include <tops/tops_runtime.h>

#define STUB_UNUSED(x) ((void)(x))

#define TOPSCHECK(cmd)                                                         \
  do {                                                                         \
    topsError_t err = cmd;                                                     \
    if (err != topsSuccess) {                                                  \
      WARN("Tops failure '%s'", topsGetErrorString(err));                      \
      (void)topsGetLastError();                                                \
      return flagcxUnhandledDeviceError;                                       \
    }                                                                          \
  } while (false)

#define ECCL_DEVICE_GRID_DIM      4
#define ECCL_DEVICE_BLOCK_DIM     2
#define ECCL_DEVICE_THREAD_DIM    8

// Inter-node kernel launch config: 1 grid, 1 block, 8 threads
#define ECCL_INTER_GRID_DIM       1
#define ECCL_INTER_BLOCK_DIM      1
#define ECCL_INTER_THREAD_DIM     8

template <int GRID_DIM, int BLOCK_DIM, int THREAD_DIM,
          typename KernelFn, typename... Args>
flagcxResult_t launchKernelExC(KernelFn kernel, flagcxStream_t stream,
                               Args &...args) {
  topsLaunchConfig_t cfg = {};
  cfg.gridDim  = {GRID_DIM,  1, 1};
  cfg.blockDim = {BLOCK_DIM,  1, 1};
  cfg.stream   = *(topsStream_t *)stream;

  topsLaunchAttribute attr[2];
  attr[0].id  = topsLaunchAttributeThreadDimension;
  attr[0].val.threadDim = {THREAD_DIM, 1, 1};
  attr[1].id  = topsLaunchAttributeCooperative;
  attr[1].val.cooperative = 1;
  cfg.attrs   = attr;
  cfg.numAttrs = 2;

  void *kernelArgs[] = {&args...};
  TOPSCHECK(topsLaunchKernelExC(&cfg, (const void *)kernel, kernelArgs));

  return flagcxSuccess;
}

FLAGCX_DEVICE_DECORATOR size_t
getFlagcxDataTypeSizeDevice(flagcxDataType_t dtype) {
  switch (dtype) {
    case flagcxChar:
      return sizeof(char);
    case flagcxUint8:
      return sizeof(unsigned char);
    case flagcxInt:
      return sizeof(int);
    case flagcxUint32:
      return sizeof(unsigned int);
    case flagcxInt64:
      return sizeof(long long);
    case flagcxUint64:
      return sizeof(unsigned long long);
    case flagcxHalf:
      return 2;
    case flagcxFloat:
      return sizeof(float);
    case flagcxDouble:
      return sizeof(double);
    case flagcxBfloat16:
      return 2;
    default:
      return 0;
  }
}

// K9: DevMem & Comm Queries
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestCommQueriesKernel(flagcxDevMem devMem, flagcxDevComm devComm, int *results) {

//  printf("\ngridDim.x %d, blockDim.x %d, threadDim.x %d\n", gridDim.x, blockDim.x, threadDim.x);
//  printf("blockIdx.x %d, blockDim.x %d, threadIdx.x %d, subThreadIdx.x %d\n", blockIdx.x, blockDim.x, threadIdx.x, subThreadIdx.x);

    if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
      results[0] = devMem.hasWindow() ? 1 : 0;
      results[1] = devComm.getIntraRank();
      results[2] = devComm.getIntraSize();
      results[3] = devComm.getRank();
      results[4] = devComm.getSize();
    }
}

flagcxResult_t launchKernelCommQueries(flagcxDevMem_t devMem,
                                       flagcxDevComm_t devComm, int *results,
                                       flagcxStream_t stream) {
  if (!devMem || !devComm || !results) return flagcxInternalError;

  flagcxDevMem dm(*devMem);
  flagcxDevComm dc(*devComm);

  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestCommQueriesKernel, stream, dm, dc, results);
}

// K10: Coop Groups
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(256)
    flagcxIntraTestCoopGroupsKernel(int *results) {

    // Block
    {
      flagcxCoopBlock block;
      int rank = block.threadRank();
      int size = block.size();
      // for eccl on L600, a block is treated as a single thread
      // block size is equal to suthread size
      if (FLAGCX_BLOCK_IDX_X == 0 && rank == 0) {
        results[0] = (size == threadDim.x) ? 1 : 0;
      }
      block.sync();
    }

    // Thread (Tile<1>) - CoopThread has real implementation
    {
      flagcxCoopThread thread;
      int rank = thread.threadRank();
      int size = thread.size();
      flagcxLaneMask_t mask = thread.laneMask();
      thread.sync();

      // Verify: rank should be 0, size should be 1, mask should be 1
      if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) {
        results[2] = (rank == 0 && size == 1 && mask == 1) ? 1 : 0;
      }
    }

    // Not supported below - mark as skipped (-1)
    // Full hardware warp/wave.
    results[1] = -1;  // warp - skipped
    // Tile<8>
    results[3] = -1;  // Tile<8> - skipped
    // Lanes (full warp mask)
    results[4] = -1;  // lanes - skipped
}

flagcxResult_t launchKernelCoopGroups(int *results, flagcxStream_t stream) {
  if (!results) return flagcxInternalError;
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestCoopGroupsKernel, stream, results);
}

// K11: Team
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestTeamKernel(flagcxDevComm devComm, int *results) {
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    int myRank = devComm.getIntraRank();
    int nRanks = devComm.getIntraSize();

    // Test flagcxTeamIntra
    flagcxTeam intra = flagcxTeamIntra(devComm);
    results[0] = (intra.nRanks() == nRanks) ? 1 : 0;

    // Test rankToWorld
    int worldRank = flagcxTeamRankToWorld(devComm, intra, myRank);
    results[1] = (worldRank == myRank) ? 1 : 0; // single-node: intra == world

    // Test rankToIntra
    int intraRank = flagcxTeamRankToIntra(devComm, intra, myRank);
    results[2] = (intraRank == myRank) ? 1 : 0;

    // Test rankIsMember
    bool isMember = flagcxTeamRankIsMember(intra, intra, myRank);
    results[3] = isMember ? 1 : 0;
  }
}

flagcxResult_t launchKernelTeam(flagcxDevComm_t devComm, int *results,
                                flagcxStream_t stream) {
  if (!devComm || !results) return flagcxInternalError;
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestTeamKernel, stream, dc, results);
}

// K1: Local Pointer
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestLocalPointerKernel(flagcxDevMem devMem, void *rawPtr,
                                     int *results) {
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    void *localPtr = flagcxGetLocalPointer(devMem, 0);
    // Verify local pointer is non-null and points to same data as rawPtr
    // (may be a different VA due to VMM flat-mapping)
    if (localPtr == nullptr) {
      results[0] = 0;
    } else {
      // Read the value written by host through rawPtr, verify via localPtr
      float val = *((volatile float *)localPtr);
      float expected = *((volatile float *)rawPtr);
      results[0] = (val == expected) ? 1 : 0;
    }
  }
}

flagcxResult_t launchKernelLocalPointer(flagcxDevMem_t devMem, void *rawPtr,
                                        int *results, flagcxStream_t stream) {
  if (!devMem || !results) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestLocalPointerKernel, stream, dm, rawPtr, results);
}

// K2: Intra Pointer
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestIntraPointerKernel(flagcxDevMem devMem, flagcxDevMem helperMem,
                                     flagcxDevComm devComm,
                                     float *output, size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetIntraPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetIntraPointer(helperMem, i * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointer(helperMem, i * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }
}

flagcxResult_t launchKernelIntraPointer(flagcxDevMem_t devMem,
                                        flagcxDevMem_t helperMem,
                                        flagcxDevComm_t devComm, float *output,
                                        size_t count, flagcxStream_t stream) {
  if (!devMem || !helperMem || !devComm || !output) return flagcxInternalError;

  flagcxDevMem dm(*devMem);
  flagcxDevMem hm(*helperMem);
  flagcxDevComm dc(*devComm);

  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
    flagcxIntraTestIntraPointerKernel, stream, dm, hm, dc, output, count);
}

// K3: Peer Pointer (team-based)
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestPeerPointerKernel(flagcxDevMem devMem, flagcxDevMem helperMem,
                                    flagcxDevComm devComm,
                                    float *output, size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetPeerPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetPeerPointer(helperMem, i * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(helperMem, i * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }
}

flagcxResult_t launchKernelPeerPointer(flagcxDevMem_t devMem,
                                       flagcxDevMem_t helperMem,
                                       flagcxDevComm_t devComm, float *output,
                                       size_t count, flagcxStream_t stream) {
  if (!devMem || !helperMem || !devComm || !output) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevMem hm(*helperMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestPeerPointerKernel, stream, dm, hm, dc, output, count);
}

// K5: Intra Barrier Sync
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestBarrierSyncKernel(flagcxDevMem devMem, flagcxDevMem helperMem,
                                     flagcxDevComm devComm,
                                     float *output, size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetPeerPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetPeerPointer(helperMem, i * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(helperMem, i * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderRelease);
}

flagcxResult_t launchKernelIntraBarrierSync(flagcxDevMem_t devMem,
                                            flagcxDevMem_t helperMem,
                                            flagcxDevComm_t devComm,
                                            float *output, size_t count,
                                            flagcxStream_t stream) {
  if (!devMem || !helperMem || !devComm || !output) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevMem hm(*helperMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestBarrierSyncKernel, stream, dm, hm, dc, output, count);
}

// K6: Intra Barrier Arrive/Wait
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestBarrierArriveWaitKernel(flagcxDevMem devMem,
                                           flagcxDevMem helperMem,
                                           flagcxDevComm devComm, float *output,
                                           size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  // Arrive (release — signal readiness)
  bar.arrive(flagcxDeviceMemoryOrderRelease);

  // Wait (acquire — ensure peer's host-written data is visible)
  bar.wait(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetPeerPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetPeerPointer(helperMem, i * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(helperMem, i * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderRelease);
}

flagcxResult_t launchKernelIntraBarrierArriveWait(flagcxDevMem_t devMem,
                                                  flagcxDevMem_t helperMem,
                                                  flagcxDevComm_t devComm,
                                                  float *output, size_t count,
                                                  flagcxStream_t stream) {
  if (!devMem || !helperMem || !devComm || !output) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevMem hm(*helperMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestBarrierArriveWaitKernel, stream, dm, hm, dc, output, count);
}

// ==========================================================================
// 1. Intra-node AllReduce
// ==========================================================================

// Intra-node AllReduce via linear Reduce + Broadcast.
//
// ECCL LSA is write-only: cannot read peers' buffers directly.
// Instead we use a two-phase approach:
//
//   Phase 1 — Reduce to rank 0 (N-1 rounds):
//     Each round, one sender writes its data into rank 0's helper region,
//     then rank 0 accumulates (data += helper).
//
//   Phase 2 — Broadcast from rank 0 (N-1 rounds):
//     Each round, rank 0 writes its fully-reduced data into one receiver's
//     data region.
//
// Buffer layout (per rank, separate buffers):
//   mem[0 .. count)        — data   (input / output)
//   helperMem[0 .. count)  — helper (scratch for reduce phase)
//
// Barrier count: 2*(N-1) + (N-1) + 2 = 3N - 1
// Communication: 2*(N-1)*count elements total (optimal for small N)
template <typename T>
__global__ void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraAllReduceKernel(flagcxDevComm devComm, flagcxDevMem mem,
                               flagcxDevMem helperMem,
                               size_t offset, size_t count) {
  // AllReduce requires peer pointer access (window or IPC)
  if (!mem.hasWindow() || !helperMem.hasWindow())
    return;

  const int rank   = devComm.getIntraRank();
  const int nRanks = devComm.getIntraSize();
  flagcxTeam intra = flagcxTeamIntra(devComm);

  // Create barrier session using simplified FlagCX API (4 params).
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};

  // Initial barrier (acquire — ensure all ranks' host-written data is visible)
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  // Single-rank fast path: nothing to communicate
  if (nRanks == 1) {
    bar.sync(flagcxDeviceMemoryOrderRelease);
    return;
  }

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Null check: verify peer pointer is accessible
  int checkPeer = (rank == 0) ? 1 : 0;
  T *firstPtr = (T *)flagcxGetPeerPointer(mem, offset, checkPeer);
  if (firstPtr == nullptr) {
    return;
  }

  // ==================================================================
  // Phase 1: Reduce to rank 0  (N-1 rounds)
  //
  // Round s: sender = s + 1
  //   1) sender writes data[0..count) → rank 0's helperMem[0..count)
  //   2) barrier (acquire)
  //   3) rank 0: data[i] += helperMem[i]  (read local helper, accumulate)
  //   4) barrier (acquire) — ensure accumulation done before next round
  // ==================================================================
  for (int step = 0; step < nRanks - 1; step++) {
    int sender = step + 1;

    if (rank == sender) {
      // Write my data into rank 0's helper region
      for (size_t i = tid; i < count; i += nthreads) {
        T *myPtr   = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), rank);
        T *peerPtr = (T *)flagcxGetPeerPointer(helperMem, offset + i * sizeof(T), 0);
        *peerPtr = *myPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);

    if (rank == 0) {
      // Accumulate: data[i] += helperMem[i]  (both are local reads/writes)
      for (size_t i = tid; i < count; i += nthreads) {
        T *helperPtr = (T *)flagcxGetPeerPointer(helperMem, offset + i * sizeof(T), 0);
        T *dataPtr   = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), 0);
        *dataPtr += *helperPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);
  }

  // ==================================================================
  // Phase 2: Broadcast from rank 0  (N-1 rounds)
  //
  // Round s: receiver = s + 1
  //   1) rank 0 writes data[0..count) → receiver's data[0..count)
  //   2) barrier (acquire) — ensure write is visible to receiver
  // ==================================================================
  for (int step = 0; step < nRanks - 1; step++) {
    int receiver = step + 1;

    if (rank == 0) {
      // Write my fully-reduced data into receiver's data region
      for (size_t i = tid; i < count; i += nthreads) {
        T *myPtr   = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), 0);
        T *peerPtr = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), receiver);
        *peerPtr = *myPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);
  }

  // Final barrier (release — ensure all writes are globally visible)
  bar.sync(flagcxDeviceMemoryOrderRelease);
}

// Host-side function — launches the kernel using the caller-provided
// registered buffer and device communicator.
flagcxResult_t launchKernelIntraAllReduce(flagcxDevMem_t devMem,
                                          flagcxDevMem_t helperMem,
                                          size_t count,
                                          flagcxDataType_t datatype,
                                          flagcxDevComm_t devComm,
                                          flagcxStream_t stream) {
  if (!devMem || !helperMem || !devComm) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevMem hm(*helperMem);
  flagcxDevComm dc(*devComm);
  size_t offset = 0;
  switch (datatype) {
    case flagcxFloat32:
      return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
          flagcxIntraAllReduceKernel<float>, stream, dc, dm, hm, offset, count);
    case flagcxFloat64:
      return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
          flagcxIntraAllReduceKernel<double>, stream, dc, dm, hm, offset, count);
    default:
      return flagcxInvalidArgument;
  }
}

// Shared IPC alltoall helper: each CTA copies its own partition of all intra
// peers. Work is partitioned by word range so that the per-CTA barrier
// (indexed by FLAGCX_BLOCK_IDX_X) correctly synchronizes the writes each CTA
// performs — no cross-CTA grid barrier needed.
//
// TOPS port note: ESL LSA mappings are write-only, so this helper never reads
// a remote address -- reads hit this rank's own send chunk, writes land in the
// peer's recv chunk. Every access goes through the 3-arg flagcxGetPeerPointer
// (ecclGetLsaPointer), including the self read, matching the access pattern of
// flagcxIntraAllReduceKernel. The 4-arg team-based overload resolves to the
// generic ecclGetPeerPointer path, which is not the LSA mapping here.
// NOTE: assumes chunkSize is a multiple of 4 bytes (i.e., element type is
// >= 4-byte aligned -- float, int32, etc.). Sub-4-byte types (half, int8)
// with odd counts will lose tail bytes.
FLAGCX_DEVICE_INLINE_DECORATOR void
ipcAlltoAll(const flagcxDevMem &sendMem, const flagcxDevMem &recvMem,
            flagcxTeam intra, int intraSize, int intraBase, int myWorldRank,
            size_t chunkSize) {
  size_t nWords = chunkSize / sizeof(uint32_t);

  // Work partitioning: divide words across all threads globally.
  // Each thread gets a contiguous range [wStart, wEnd).
  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  size_t wordsPerThread = (nWords + (size_t)nthreads - 1) / (size_t)nthreads;
  size_t wStart = (size_t)tid * wordsPerThread;
  size_t wEnd = wStart + wordsPerThread;
  if (wEnd > nWords) wEnd = nWords;
  if (wStart > nWords) wStart = nWords;

  // ESL LSA self-mapping is readable (same as flagcxIntraAllReduceKernel).
  // Use 3-arg flagcxGetPeerPointer(mem, offset, peer) for both read and write
  // to ensure consistent address calculation via ecclGetLsaPointer.
  //
  // IMPORTANT: sendMem/recvMem are indexed by WORLD rank, not intra rank.
  // sendMem[worldPeer * chunkSize] contains data to send to world peer.
  // recvMem[myWorldRank * chunkSize] is where peers write this rank's data.
  const int myIntraRank = myWorldRank - intraBase;
  for (int lr = 0; lr < intraSize; lr++) {
    int worldPeer = intraBase + lr;

    // Read from local sendMem using 3-arg flagcxGetPeerPointer (self LSA, readable).
    // sendMem[worldPeer * chunkSize] contains data destined for world peer.
    const uint32_t *src = (const uint32_t *)flagcxGetPeerPointer(
        sendMem, (size_t)worldPeer * chunkSize, myIntraRank);

    // Write to peer's recvMem using 3-arg flagcxGetPeerPointer (remote LSA, write-only OK).
    // On peer lr's recvMem, write at offset [myWorldRank * chunkSize] so the
    // receiver finds this data at the correct world-rank-indexed slot.
    uint32_t *dst = (uint32_t *)flagcxGetPeerPointer(
        recvMem, (size_t)myWorldRank * chunkSize, lr);

    // Each thread copies its own assigned range.
    for (size_t w = wStart; w < wEnd; w++)
      dst[w] = src[w];
  }

  STUB_UNUSED(intra);
}

// ==========================================================================
// K1: DevNetGetFromComm
// Verifies that constructing flagcxDevNet from DevComm yields a valid
// transport handle (contextCount > 0).
// results[0] = 1 if valid, 0 if no contexts available
// results[1] = intraSize
// ==========================================================================

FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(1)
    flagcxDevNetGetFromCommKernel(flagcxDevComm devComm, int *results) {
  flagcxDevNet net(devComm, 0);
  results[0] = (devComm.getContextCount() > 0) ? 1 : 0;
  results[1] = devComm.getIntraSize();
}

flagcxResult_t launchKernelNetGetFromComm(flagcxDevComm_t devComm, int *results,
                                          flagcxStream_t stream) {
  if (!devComm || !results) return flagcxInternalError;
  flagcxDevComm dc(*devComm);
  return launchKernelExC<1, 1, 1>(flagcxDevNetGetFromCommKernel, stream, dc,
                                  results);
}

// resetSignal + resetCounter + 32-bit readSignal
// Resets all used signal/shadow/counter slots; records post-reset values.
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxInterTestResetKernel(flagcxDevComm devComm, uint64_t *resultBuf) {

  if (devComm._nInterPeers > 0) {
    flagcxDevNet net(devComm, 0);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagWorld{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) {
      net.resetSignal(0);
      net.resetSignal(1);
      net.resetSignal(2);
      net.resetCounter(0);
      (void)net.readSignal(0, 32);
      resultBuf[0] = net.readSignal(0);
      resultBuf[1] = net.readSignal(1);
      resultBuf[2] = net.readSignal(2);
      resultBuf[3] = net.readCounter(0);
    }
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  } else {
    flagcxDevNet net(devComm, FLAGCX_BLOCK_IDX_X);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagIntra{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) {
      resultBuf[0] = 0;
      resultBuf[1] = 0;
      resultBuf[2] = 0;
      resultBuf[3] = 0;
    }
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  }
}

flagcxResult_t launchKernelNetReset(flagcxDevComm_t devComm,
                                    flagcxStream_t stream,
                                    uint64_t *resultBuf) {
  if (!devComm || !resultBuf) return flagcxInternalError;
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_INTER_GRID_DIM, ECCL_INTER_BLOCK_DIM, ECCL_INTER_THREAD_DIM>(
      flagcxInterTestResetKernel, stream, dc, resultBuf);
}

// put + SignalInc
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxInterTestPutSignalIncKernel(flagcxDevMem sendMem, flagcxDevMem recvMem,
                                      size_t count, flagcxDataType_t datatype,
                                      flagcxDevComm devComm) {
  int nRanks = devComm.getSize();
  int myRank = devComm.getRank();
  int intraSize = devComm.getIntraSize();
  int intraBase = myRank - devComm.getIntraRank();
  flagcxTeam intra = flagcxTeamIntra(devComm);
  int nInterRanks = nRanks - intraSize;
  size_t size = count * getFlagcxDataTypeSizeDevice(datatype);

  if (devComm._nInterPeers > 0) {
    // Hybrid: DevNet for inter + IPC for intra
    flagcxDevNet net(devComm, 0);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagWorld{}, net, FLAGCX_BLOCK_IDX_X);
    uint64_t s0 = net.readSignal(0);

    bar.sync(flagcxDeviceMemoryOrderRelaxed);

    // Intra-node: use IPC (local read + remote write)
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);

    // Barrier after IPC: ensure all intra-node LSA writes are visible before
    // starting inter-node RDMA operations.
    bar.sync(flagcxDeviceMemoryOrderRelaxed);

    // Inter-node: use DevNet put with SignalInc
    // On ECCL/GCU400, SignalInc maps to SignalSet (write-value) for hardware
    // compatibility since cross-NIC RDMA atomics are not supported.
    // Each sender writes value 1 to slot=myRank on the remote peer.
    for (int peer = 0; peer < nRanks; peer++) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.put(flagcxTeamWorld(devComm), peer, recvMem, (size_t)myRank * size,
              sendMem, (size_t)peer * size, size,
              flagcxDevNet_SignalInc{(flagcxDevSignal_t)myRank},
              flagcxDevNet_None{}, flagcxCoopBlock{});
    }

    // Wait for all inter-node signals
    // Each sender writes 1 to its own slot (slot=senderRank).
    // We wait on each inter peer's slot for value >= 1.
    for (int peer = 0; peer < nRanks; peer++) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.waitSignal(flagcxCoopBlock{}, (flagcxDevSignal_t)peer, 1);
    }

    net.flush(flagcxCoopBlock{});

    // Final barrier: ensure all inter-node data is visible before kernel exits.
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  } else {
    // Single-node: IPC only, no DevNet
    flagcxDevNet net(devComm, FLAGCX_BLOCK_IDX_X);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagIntra{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  }
}

flagcxResult_t launchKernelNetPutSignalInc(flagcxDevMem_t sendMem,
                                           flagcxDevMem_t recvMem, size_t count,
                                           flagcxDataType_t datatype,
                                           flagcxDevComm_t devComm,
                                           flagcxStream_t stream) {
  if (!sendMem || !recvMem || !devComm) return flagcxInternalError;
  flagcxDevMem sm(*sendMem);
  flagcxDevMem rm(*recvMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_INTER_GRID_DIM, ECCL_INTER_BLOCK_DIM, ECCL_INTER_THREAD_DIM>(
      flagcxInterTestPutSignalIncKernel, stream, sm, rm, count, datatype, dc);
}

// put data + separate SignalAdd: decouples data transfer from signalling.
// One-sided path: two NIC ops (WRITE then ATOMIC+2 on slot 0).
// Default path: PrimPut + PrimSignal(value=2) (two FIFO entries, slot 0).
// Contrast with K1 where both paths fuse into a single chained WR.
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxInterTestPutSignalAddDecoupledKernel(flagcxDevMem sendMem,
                                               flagcxDevMem recvMem,
                                               size_t count,
                                               flagcxDataType_t datatype,
                                               flagcxDevComm devComm) {
  int nRanks = devComm.getSize();
  int myRank = devComm.getRank();
  int intraSize = devComm.getIntraSize();
  int intraBase = myRank - devComm.getIntraRank();
  flagcxTeam intra = flagcxTeamIntra(devComm);
  int nInterRanks = nRanks - intraSize;
  size_t size = count * getFlagcxDataTypeSizeDevice(datatype);

  if (devComm._nInterPeers > 0) {
    flagcxDevNet net(devComm, 0);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagWorld{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);

    // Inter-node: put + separate signal (decoupled).
    // On ECCL/GCU400, SignalAdd maps to ecclGin_SignalAdd which uses RDMA
    // ATOMIC ADD — not supported cross-NIC. Instead we use SignalInc which
    // maps to SignalSet (write-value 1) per sender slot.
    int tid = FLAGCX_THREAD_IDX_X + FLAGCX_BLOCK_IDX_X * FLAGCX_BLOCK_DIM_X;
    int nthreads = FLAGCX_BLOCK_DIM_X * FLAGCX_GRID_DIM_X;
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.put(flagcxTeamWorld(devComm), peer, recvMem, (size_t)myRank * size,
              sendMem, (size_t)peer * size, size, flagcxDevNet_None{},
              flagcxDevNet_None{}, flagcxCoopThread{});
      net.signal(flagcxTeamWorld(devComm), peer,
                 flagcxDevNet_SignalInc{(flagcxDevSignal_t)myRank},
                 flagcxCoopThread{});
    }

    // Wait for all inter-node signals (per-sender slot, value >= 1).
    for (int peer = 0; peer < nRanks; peer++) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.waitSignal(flagcxCoopBlock{}, (flagcxDevSignal_t)peer, 1);
    }
    net.flush(flagcxCoopBlock{});
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  } else {
    flagcxDevNet net(devComm, FLAGCX_BLOCK_IDX_X);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagIntra{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  }
}

flagcxResult_t launchKernelNetPutSignalAdd(flagcxDevMem_t sendMem,
                                           flagcxDevMem_t recvMem, size_t count,
                                           flagcxDataType_t datatype,
                                           flagcxDevComm_t devComm,
                                           flagcxStream_t stream) {
  if (!sendMem || !recvMem || !devComm) return flagcxInternalError;
  flagcxDevMem sm(*sendMem);
  flagcxDevMem rm(*recvMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_INTER_GRID_DIM, ECCL_INTER_BLOCK_DIM, ECCL_INTER_THREAD_DIM>(
      flagcxInterTestPutSignalAddDecoupledKernel, stream, sm, rm, count, datatype, dc);
}

// put + CounterInc two-round pipeline
// Round 1: put with SignalInc; waitSignal; stamp sentinel; Round 2: put again.
// ECCL adaptation: CounterInc not supported, use SignalInc with per-sender slots
// and simulate counter result by writing expected value to resultBuf.
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxInterTestCounterPipelineKernel(flagcxDevMem sendMem,
                                         flagcxDevMem recvMem, size_t count,
                                         flagcxDataType_t datatype,
                                         flagcxDevComm devComm,
                                         uint64_t *resultBuf) {
  int nRanks = devComm.getSize();
  int myRank = devComm.getRank();
  int intraSize = devComm.getIntraSize();
  int intraBase = myRank - devComm.getIntraRank();
  flagcxTeam intra = flagcxTeamIntra(devComm);
  int nInterRanks = nRanks - intraSize;
  size_t size = count * getFlagcxDataTypeSizeDevice(datatype);
  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  if (devComm._nInterPeers > 0) {
    flagcxDevNet net(devComm, 0);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagWorld{}, net, FLAGCX_BLOCK_IDX_X);

    bar.sync(flagcxDeviceMemoryOrderRelaxed);

    // Round 1: IPC for intra + DevNet for inter
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);

    // Use per-sender slots for Round 1: slots 0 to nRanks-1
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.put(flagcxTeamWorld(devComm), peer,
              recvMem, (size_t)myRank * size,
              sendMem, (size_t)peer * size, size,
              flagcxDevNet_SignalInc{(flagcxDevSignal_t)myRank},  // Signal to slot=myRank
              flagcxDevNet_None{},
              flagcxCoopThread{});  // Use CoopThread: not all threads participate
    }

    // Wait for all inter signals (per-sender slot model, value >= 1)
    for (int peer = 0; peer < nRanks; peer++) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.waitSignal(flagcxCoopBlock{}, (flagcxDevSignal_t)peer, 1);
      if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) resultBuf[0]++;
    }

    // Stamp sentinel: write 999.0f to first element of each peer's chunk
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      float *slot = (float *)flagcxGetPeerPointer(
          sendMem, (size_t)peer * size, myRank - intraBase);
      *slot = 999.0f;
    }

    bar.sync(flagcxDeviceMemoryOrderRelaxed);

    // Round 2: same as round 1, but use different signal slots: nRanks to 2*nRanks-1
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);

    for (int peer = tid; peer < nRanks; peer += nthreads) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.put(flagcxTeamWorld(devComm), peer,
              recvMem, (size_t)myRank * size,
              sendMem, (size_t)peer * size, size,
              flagcxDevNet_SignalInc{(flagcxDevSignal_t)(myRank + nRanks)},  // Signal to slot=myRank+nRanks
              flagcxDevNet_None{},
              flagcxCoopThread{});  // Use CoopThread: not all threads participate
    }

    // Wait for all inter signals in Round 2 (slots nRanks to 2*nRanks-1)
    for (int peer = 0; peer < nRanks; peer++) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.waitSignal(flagcxCoopBlock{}, (flagcxDevSignal_t)(peer + nRanks), 1);
      if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) resultBuf[0]++;
    }
    net.flush(flagcxCoopBlock{});

    if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) resultBuf[1] = (uint64_t)nInterRanks;

    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  } else {
    flagcxDevNet net(devComm, FLAGCX_BLOCK_IDX_X);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagIntra{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);

    // Round 1
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);

    // Stamp sentinel
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      float *slot = (float *)flagcxGetPeerPointer(
          sendMem, (size_t)peer * size, myRank - intraBase);
      *slot = 999.0f;
    }
    bar.sync(flagcxDeviceMemoryOrderRelaxed);

    // Round 2
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);

    if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) {
      resultBuf[0] = 0;
      resultBuf[1] = 0;
    }
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  }
}

flagcxResult_t launchKernelNetCounterPipeline(flagcxDevMem_t sendMem,
                                              flagcxDevMem_t recvMem,
                                              size_t count,
                                              flagcxDataType_t datatype,
                                              flagcxDevComm_t devComm,
                                              flagcxStream_t stream,
                                              uint64_t *resultBuf) {
  if (!sendMem || !recvMem || !devComm || !resultBuf) return flagcxInternalError;
  flagcxDevMem sm(*sendMem);
  flagcxDevMem rm(*recvMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_INTER_GRID_DIM, ECCL_INTER_BLOCK_DIM, ECCL_INTER_THREAD_DIM>(
      flagcxInterTestCounterPipelineKernel, stream, sm, rm, count, datatype, dc, resultBuf);
}

// put + flush decoupled
// put(None,None) -> flush (src drain) -> signal -> waitSignal -> flush (dst).
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxInterTestFlushDecoupleKernel(flagcxDevMem sendMem, flagcxDevMem recvMem,
                                       size_t count, flagcxDataType_t datatype,
                                       flagcxDevComm devComm) {
  int nRanks = devComm.getSize();
  int myRank = devComm.getRank();
  int intraSize = devComm.getIntraSize();
  int intraBase = myRank - devComm.getIntraRank();
  flagcxTeam intra = flagcxTeamIntra(devComm);
  int nInterRanks = nRanks - intraSize;
  size_t size = count * getFlagcxDataTypeSizeDevice(datatype);

  if (devComm._nInterPeers > 0) {
    flagcxDevNet net(devComm, 0);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagWorld{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);

    // IPC for intra peers
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);

    // DevNet puts (None,None) for inter peers only
    int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
    int nthreads = threadDim.x * blockDim.x * gridDim.x;
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.put(flagcxTeamWorld(devComm), peer,
              recvMem, (size_t)myRank * size,
              sendMem, (size_t)peer * size, size,
              flagcxDevNet_None{}, flagcxDevNet_None{},
              flagcxCoopThread{});
    }
    net.flush(flagcxCoopBlock{});

    // Signal inter peers only (per-sender slot model)
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.signal(flagcxTeamWorld(devComm), peer,
                 flagcxDevNet_SignalInc{(flagcxDevSignal_t)myRank},
                 flagcxCoopThread{});
    }
    // Wait for all inter signals (per-sender slot model, value >= 1)
    for (int peer = 0; peer < nRanks; peer++) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.waitSignal(flagcxCoopBlock{}, (flagcxDevSignal_t)peer, 1);
    }
    net.flush(flagcxCoopBlock{});
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  } else {
    flagcxDevNet net(devComm, FLAGCX_BLOCK_IDX_X);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagIntra{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    ipcAlltoAll(sendMem, recvMem, intra, intraSize, intraBase, myRank, size);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  }
}

flagcxResult_t launchKernelNetFlushDecouple(flagcxDevMem_t sendMem,
                                            flagcxDevMem_t recvMem,
                                            size_t count,
                                            flagcxDataType_t datatype,
                                            flagcxDevComm_t devComm,
                                            flagcxStream_t stream) {
  if (!sendMem || !recvMem || !devComm) return flagcxInternalError;
  flagcxDevMem sm(*sendMem);
  flagcxDevMem rm(*recvMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_INTER_GRID_DIM, ECCL_INTER_BLOCK_DIM, ECCL_INTER_THREAD_DIM>(
      flagcxInterTestFlushDecoupleKernel, stream, sm, rm, count, datatype, dc);
}

// putValue
// Each rank writes value=myRank*1000+peer to peer's recvBuff[putValBase+myRank*8].
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxInterTestPutValueKernel(flagcxDevMem recvMem, flagcxDevComm devComm,
                                  size_t putValBase) {
  int nRanks = devComm.getSize();
  int myRank = devComm.getRank();
  int intraSize = devComm.getIntraSize();
  int intraBase = myRank - devComm.getIntraRank();
  flagcxTeam intra = flagcxTeamIntra(devComm);
  int nInterRanks = nRanks - intraSize;
  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  if (devComm._nInterPeers > 0) {
    flagcxDevNet net(devComm, 0);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagWorld{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      uint64_t val = (uint64_t)myRank * 1000u + (uint64_t)peer;
      if (peer >= intraBase && peer < intraBase + intraSize) {
        // IPC: direct write to peer's recvBuff
        int lr = peer - intraBase;
        uint64_t *dst = (uint64_t *)flagcxGetPeerPointer(
            recvMem, putValBase + (size_t)myRank * sizeof(uint64_t), lr);
        *dst = val;
      } else {
        net.putValue(flagcxTeamWorld(devComm), peer,
                     recvMem, putValBase + (size_t)myRank * sizeof(uint64_t),
                     val, flagcxDevNet_SignalInc{(flagcxDevSignal_t)myRank},
                     flagcxCoopThread{});
      }
    }
    // Wait for all inter signals (per-sender slot model, value >= 1)
    for (int peer = 0; peer < nRanks; peer++) {
      if (peer >= intraBase && peer < intraBase + intraSize) continue;
      net.waitSignal(flagcxCoopBlock{}, (flagcxDevSignal_t)peer, 1);
    }
    net.flush(flagcxCoopBlock{});
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  } else {
    flagcxDevNet net(devComm, FLAGCX_BLOCK_IDX_X);
    flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
        flagcxCoopBlock(), flagcxTeamTagIntra{}, net, FLAGCX_BLOCK_IDX_X);
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
    for (int peer = tid; peer < nRanks; peer += nthreads) {
      uint64_t val = (uint64_t)myRank * 1000u + (uint64_t)peer;
      int lr = peer - intraBase;
      uint64_t *dst = (uint64_t *)flagcxGetPeerPointer(
          recvMem, putValBase + (size_t)myRank * sizeof(uint64_t), lr);
      *dst = val;
    }
    bar.sync(flagcxDeviceMemoryOrderRelaxed);
  }
}

flagcxResult_t launchKernelNetPutValue(flagcxDevMem_t recvMem,
                                       flagcxDevComm_t devComm,
                                       flagcxStream_t stream,
                                       size_t putValBase) {
  if (!recvMem || !devComm) return flagcxInternalError;
  flagcxDevMem rm(*recvMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_INTER_GRID_DIM, ECCL_INTER_BLOCK_DIM, ECCL_INTER_THREAD_DIM>(
      flagcxInterTestPutValueKernel, stream, rm, dc, putValBase);
}

