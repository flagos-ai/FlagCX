/*************************************************************************
 * Copyright (c) 2025, ENFLAME CORPORATION. All rights reserved.
 *
 * FlagCX Device API test kernels — Enflame (TOPS) backend.
 *
 * Signature-compatible with test/kernel/nvidia/device_api.cu (and
 * test/kernel/du/device_api.cu): same kernel/launcher names, same parameters,
 * same order, so test/kernel/include/device_api.h and the harness under
 * test/unittest/device_api/ link unchanged.
 *
 * The bodies are intentionally NOT implemented yet — every entry point
 * returns immediately. That keeps the platform wired end-to-end (compiles,
 * links, the suites run) while the kernels are ported one at a time. Each
 * stub carries the original nvidia logic in a comment plus a TODO.
 *
 * Porting notes for this platform:
 *   - Kernel launch syntax is the nvcc-style <<<grid, block, shmem, stream>>>,
 *     but the stream type is topsStream_t, not cudaStream_t, so launchers must
 *     do `topsStream_t ts = *(topsStream_t *)stream;`.
 *   - Report errors with topsGetLastError()/topsSuccess instead of
 *     cudaGetLastError()/cudaSuccess.
 *   - CommTraits on this platform is the ECCL one
 *     (flagcx/adaptor/include/device_api/eccl_comm_traits.h), selected by
 *     -DFLAGCX_COMM_TRAITS_CCL.
 *
 * Host-side flagcxDevCommCreate/Destroy are in flagcx_device.cc.
 ************************************************************************/

#include "device_api/flagcx_device.h"
#include "enflame_adaptor.h"
#include "global_comm.h"
#include "flagcx_kernel.h"
#include <tops/tops_runtime.h>

#define STUB_UNUSED(x) ((void)(x))

#define TOPSCHECK(cmd)                                                         \
  do {                                                                         \
    topsError_t err = cmd;                                                     \
    if (err != topsSuccess) {                                                  \
      WARN("Tops failure '%s'", topsGetErrorString(err));                      \
      (void)topsGetLastError();                                                \
      return flagcxUnhandledDeviceError;                                       \
    }                                                                          \
  } while (false)

#define ECCL_DEVICE_GRID_DIM      4
#define ECCL_DEVICE_BLOCK_DIM     2
#define ECCL_DEVICE_THREAD_DIM    4

template <int GRID_DIM, int BLOCK_DIM, int THREAD_DIM,
          typename KernelFn, typename... Args>
flagcxResult_t launchKernelExC(KernelFn kernel, flagcxStream_t stream,
                               Args &...args) {
  topsLaunchConfig_t cfg = {};
  cfg.gridDim  = {GRID_DIM,  1, 1};
  cfg.blockDim = {BLOCK_DIM,  1, 1};
  cfg.stream   = *(topsStream_t *)stream;

  topsLaunchAttribute attr[2];
  attr[0].id  = topsLaunchAttributeThreadDimension;
  attr[0].val.threadDim = {THREAD_DIM, 1, 1};
  attr[1].id  = topsLaunchAttributeCooperative;
  attr[1].val.cooperative = 1;
  cfg.attrs   = attr;
  cfg.numAttrs = 2;

  void *kernelArgs[] = {&args...};
  TOPSCHECK(topsLaunchKernelExC(&cfg, (const void *)kernel, kernelArgs));

  return flagcxSuccess;
}

FLAGCX_DEVICE_DECORATOR size_t
getFlagcxDataTypeSizeDevice(flagcxDataType_t dtype) {
  switch (dtype) {
    case flagcxChar:
      return sizeof(char);
    case flagcxUint8:
      return sizeof(unsigned char);
    case flagcxInt:
      return sizeof(int);
    case flagcxUint32:
      return sizeof(unsigned int);
    case flagcxInt64:
      return sizeof(long long);
    case flagcxUint64:
      return sizeof(unsigned long long);
    case flagcxHalf:
      return 2;
    case flagcxFloat:
      return sizeof(float);
    case flagcxDouble:
      return sizeof(double);
    case flagcxBfloat16:
      return 2;
    default:
      return 0;
  }
}

// K9: DevMem & Comm Queries
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestCommQueriesKernel(flagcxDevMem devMem, flagcxDevComm devComm, int *results) {

//  printf("\ngridDim.x %d, blockDim.x %d, threadDim.x %d\n", gridDim.x, blockDim.x, threadDim.x);
//  printf("blockIdx.x %d, blockDim.x %d, threadIdx.x %d, subThreadIdx.x %d\n", blockIdx.x, blockDim.x, threadIdx.x, subThreadIdx.x);

    if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
      results[0] = devMem.hasWindow() ? 1 : 0;
      results[1] = devComm.getIntraRank();
      results[2] = devComm.getIntraSize();
      results[3] = devComm.getRank();
      results[4] = devComm.getSize();
    }
}

flagcxResult_t launchKernelCommQueries(flagcxDevMem_t devMem,
                                       flagcxDevComm_t devComm, int *results,
                                       flagcxStream_t stream) {
  if (!devMem || !devComm || !results) return flagcxInternalError;

  flagcxDevMem dm(*devMem);
  flagcxDevComm dc(*devComm);

  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestCommQueriesKernel, stream, dm, dc, results);
}

// K10: Coop Groups
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(256)
    flagcxIntraTestCoopGroupsKernel(int *results) {

    // Block
    {
      flagcxCoopBlock block;
      int rank = block.threadRank();
      int size = block.size();
      // for eccl on L600, a block is treated as a single thread
      // block size is equal to suthread size
      if (FLAGCX_BLOCK_IDX_X == 0 && rank == 0) {
        results[0] = (size == threadDim.x) ? 1 : 0;
      }
      block.sync();
    }

    // Thread (Tile<1>) - CoopThread has real implementation
    {
      flagcxCoopThread thread;
      int rank = thread.threadRank();
      int size = thread.size();
      flagcxLaneMask_t mask = thread.laneMask();
      thread.sync();
      
      // Verify: rank should be 0, size should be 1, mask should be 1
      if (FLAGCX_BLOCK_IDX_X == 0 && FLAGCX_THREAD_IDX_X == 0) {
        results[2] = (rank == 0 && size == 1 && mask == 1) ? 1 : 0;
      }
    }

    // Not supported below - mark as skipped (-1)
    // Full hardware warp/wave.
    results[1] = -1;  // warp - skipped
    // Tile<8>
    results[3] = -1;  // Tile<8> - skipped
    // Lanes (full warp mask)
    results[4] = -1;  // lanes - skipped
}

flagcxResult_t launchKernelCoopGroups(int *results, flagcxStream_t stream) {
  if (!results) return flagcxInternalError;
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestCoopGroupsKernel, stream, results);
}

// K11: Team
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestTeamKernel(flagcxDevComm devComm, int *results) {
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    int myRank = devComm.getIntraRank();
    int nRanks = devComm.getIntraSize();

    // Test flagcxTeamIntra
    flagcxTeam intra = flagcxTeamIntra(devComm);
    results[0] = (intra.nRanks() == nRanks) ? 1 : 0;

    // Test rankToWorld
    int worldRank = flagcxTeamRankToWorld(devComm, intra, myRank);
    results[1] = (worldRank == myRank) ? 1 : 0; // single-node: intra == world

    // Test rankToIntra
    int intraRank = flagcxTeamRankToIntra(devComm, intra, myRank);
    results[2] = (intraRank == myRank) ? 1 : 0;

    // Test rankIsMember
    bool isMember = flagcxTeamRankIsMember(intra, intra, myRank);
    results[3] = isMember ? 1 : 0;
  }
}

flagcxResult_t launchKernelTeam(flagcxDevComm_t devComm, int *results,
                                flagcxStream_t stream) {
  if (!devComm || !results) return flagcxInternalError;
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestTeamKernel, stream, dc, results);
}

// K1: Local Pointer
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestLocalPointerKernel(flagcxDevMem devMem, void *rawPtr,
                                     int *results) {
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    void *localPtr = flagcxGetLocalPointer(devMem, 0);
    // Verify local pointer is non-null and points to same data as rawPtr
    // (may be a different VA due to VMM flat-mapping)
    if (localPtr == nullptr) {
      results[0] = 0;
    } else {
      // Read the value written by host through rawPtr, verify via localPtr
      float val = *((volatile float *)localPtr);
      float expected = *((volatile float *)rawPtr);
      results[0] = (val == expected) ? 1 : 0;
    }
  }
}

flagcxResult_t launchKernelLocalPointer(flagcxDevMem_t devMem, void *rawPtr,
                                        int *results, flagcxStream_t stream) {
  if (!devMem || !results) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestLocalPointerKernel, stream, dm, rawPtr, results);
}

// K2: Intra Pointer
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestIntraPointerKernel(flagcxDevMem devMem, flagcxDevComm devComm,
                                     float *output, size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetIntraPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetIntraPointer(devMem, (count + i ) * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointer(devMem, (count + i ) * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }
}

flagcxResult_t launchKernelIntraPointer(flagcxDevMem_t devMem,
                                        flagcxDevComm_t devComm, float *output,
                                        size_t count, flagcxStream_t stream) {
  if (!devMem || !devComm || !output) return flagcxInternalError;

  flagcxDevMem dm(*devMem);
  flagcxDevComm dc(*devComm);

  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
    flagcxIntraTestIntraPointerKernel, stream, dm, dc, output, count);
}

// K3: Peer Pointer (team-based)
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestPeerPointerKernel(flagcxDevMem devMem, flagcxDevComm devComm,
                                    float *output, size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetPeerPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetPeerPointer(devMem, (count + i ) * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, (count + i ) * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }
}

flagcxResult_t launchKernelPeerPointer(flagcxDevMem_t devMem,
                                       flagcxDevComm_t devComm, float *output,
                                       size_t count, flagcxStream_t stream) {
  if (!devMem || !devComm || !output) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestPeerPointerKernel, stream, dm, dc, output, count);
}

// K5: Intra Barrier Sync
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestBarrierSyncKernel(flagcxDevMem devMem, flagcxDevComm devComm,
                                     float *output, size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetPeerPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetPeerPointer(devMem, (count + i ) * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, (count + i ) * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderRelease);
}

flagcxResult_t launchKernelIntraBarrierSync(flagcxDevMem_t devMem,
                                            flagcxDevComm_t devComm,
                                            float *output, size_t count,
                                            flagcxStream_t stream) {
  if (!devMem || !devComm || !output) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestBarrierSyncKernel, stream, dm, dc, output, count);
}

// K6: Intra Barrier Arrive/Wait
FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraTestBarrierArriveWaitKernel(flagcxDevMem devMem,
                                           flagcxDevComm devComm, float *output,
                                           size_t count) {
  int myRank = devComm.getIntraRank();
  int nRanks = devComm.getIntraSize();
  int peer  = (myRank + nRanks - 1) % nRanks;
  flagcxTeam intra = flagcxTeamIntra(devComm);

  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  // Arrive (release — signal readiness)
  bar.arrive(flagcxDeviceMemoryOrderRelease);

  // Wait (acquire — ensure peer's host-written data is visible)
  bar.wait(flagcxDeviceMemoryOrderAcquire);

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetPeerPointer(devMem, tid * sizeof(float), peer);
  if (firstPtr == nullptr){
    return;
  }

  // ECCL LSA write-only, cannot read peers' send buffers.
  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetPeerPointer(devMem, (count + i ) * sizeof(float), peer);
    // write my data to peer helper mem
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (size_t i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointer(devMem, (count + i ) * sizeof(float), myRank);
    // read data from local helper mem
    output[i] = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderRelease);
}

flagcxResult_t launchKernelIntraBarrierArriveWait(flagcxDevMem_t devMem,
                                                  flagcxDevComm_t devComm,
                                                  float *output, size_t count,
                                                  flagcxStream_t stream) {
  if (!devMem || !devComm || !output) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevComm dc(*devComm);
  return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      flagcxIntraTestBarrierArriveWaitKernel, stream, dm, dc, output, count);
}

// ==========================================================================
// 1. Intra-node AllReduce
// ==========================================================================

// Intra-node AllReduce via linear Reduce + Broadcast.
//
// ECCL LSA is write-only: cannot read peers' buffers directly.
// Instead we use a two-phase approach:
//
//   Phase 1 — Reduce to rank 0 (N-1 rounds):
//     Each round, one sender writes its data into rank 0's helper region,
//     then rank 0 accumulates (data += helper).
//
//   Phase 2 — Broadcast from rank 0 (N-1 rounds):
//     Each round, rank 0 writes its fully-reduced data into one receiver's
//     data region.
//
// Buffer layout (per rank, same registered buffer):
//   [0 .. count)           — data   (input / output)
//   [count .. 2*count)     — helper (scratch for reduce phase)
//
// Barrier count: 2*(N-1) + (N-1) + 2 = 3N - 1
// Communication: 2*(N-1)*count elements total (optimal for small N)
template <typename T>
__global__ void __launch_bounds__(FLAGCX_DEVICE_THREADS_PER_CTA)
    flagcxIntraAllReduceKernel(flagcxDevComm devComm, flagcxDevMem mem,
                               size_t offset, size_t count) {
  // AllReduce requires peer pointer access (window or IPC)
  if (!mem.hasWindow())
    return;

  const int rank   = devComm.getIntraRank();
  const int nRanks = devComm.getIntraSize();
  flagcxTeam intra = flagcxTeamIntra(devComm);

  // Create barrier session using simplified FlagCX API (4 params).
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), devComm, intra, blockIdx.x * blockDim.x + threadIdx.x};

  // Initial barrier (acquire — ensure all ranks' host-written data is visible)
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  // Single-rank fast path: nothing to communicate
  if (nRanks == 1) {
    bar.sync(flagcxDeviceMemoryOrderRelease);
    return;
  }

  int tid      = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Null check: verify peer pointer is accessible
  int checkPeer = (rank == 0) ? 1 : 0;
  T *firstPtr = (T *)flagcxGetPeerPointer(mem, offset, checkPeer);
  if (firstPtr == nullptr) {
    return;
  }

  // ==================================================================
  // Phase 1: Reduce to rank 0  (N-1 rounds)
  //
  // Round s: sender = s + 1
  //   1) sender writes data[0..count) → rank 0's helper[count..2*count)
  //   2) barrier (acquire)
  //   3) rank 0: data[i] += helper[i]  (read local helper, accumulate)
  //   4) barrier (acquire) — ensure accumulation done before next round
  // ==================================================================
  for (int step = 0; step < nRanks - 1; step++) {
    int sender = step + 1;

    if (rank == sender) {
      // Write my data into rank 0's helper region
      for (size_t i = tid; i < count; i += nthreads) {
        T *myPtr   = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), rank);
        T *peerPtr = (T *)flagcxGetPeerPointer(mem, offset + (count + i) * sizeof(T), 0);
        *peerPtr = *myPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);

    if (rank == 0) {
      // Accumulate: data[i] += helper[i]  (both are local reads/writes)
      for (size_t i = tid; i < count; i += nthreads) {
        T *helperPtr = (T *)flagcxGetPeerPointer(mem, offset + (count + i) * sizeof(T), 0);
        T *dataPtr   = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), 0);
        *dataPtr += *helperPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);
  }

  // ==================================================================
  // Phase 2: Broadcast from rank 0  (N-1 rounds)
  //
  // Round s: receiver = s + 1
  //   1) rank 0 writes data[0..count) → receiver's data[0..count)
  //   2) barrier (acquire) — ensure write is visible to receiver
  // ==================================================================
  for (int step = 0; step < nRanks - 1; step++) {
    int receiver = step + 1;

    if (rank == 0) {
      // Write my fully-reduced data into receiver's data region
      for (size_t i = tid; i < count; i += nthreads) {
        T *myPtr   = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), 0);
        T *peerPtr = (T *)flagcxGetPeerPointer(mem, offset + i * sizeof(T), receiver);
        *peerPtr = *myPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);
  }

  // Final barrier (release — ensure all writes are globally visible)
  bar.sync(flagcxDeviceMemoryOrderRelease);
}

// Host-side function — launches the kernel using the caller-provided
// registered buffer and device communicator.
flagcxResult_t launchKernelIntraAllReduce(flagcxDevMem_t devMem, size_t count,
                                          flagcxDataType_t datatype,
                                          flagcxDevComm_t devComm,
                                          flagcxStream_t stream) {
  if (!devMem || !devComm) return flagcxInternalError;
  flagcxDevMem dm(*devMem);
  flagcxDevComm dc(*devComm);
  size_t offset = 0;
  switch (datatype) {
    case flagcxFloat32:
      return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
          flagcxIntraAllReduceKernel<float>, stream, dc, dm, offset, count);
    case flagcxFloat64:
      return launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
          flagcxIntraAllReduceKernel<double>, stream, dc, dm, offset, count);
    default:
      return flagcxInvalidArgument;
  }
}

// ==========================================================================
// K1: DevNetGetFromComm
// Verifies that constructing flagcxDevNet from DevComm yields a valid
// transport handle (contextCount > 0).
// results[0] = 1 if valid, 0 if no contexts available
// results[1] = intraSize
// ==========================================================================

FLAGCX_GLOBAL_DECORATOR void __launch_bounds__(1)
    flagcxDevNetGetFromCommKernel(flagcxDevComm devComm, int *results) {
  // TODO, gin not support now
  STUB_UNUSED(devComm);
  STUB_UNUSED(results);
}

flagcxResult_t launchKernelNetGetFromComm(flagcxDevComm_t devComm, int *results,
                                          flagcxStream_t stream) {
  if (!devComm || !results) return flagcxInternalError;
  flagcxDevComm dc(*devComm);
