/*************************************************************************
 * Copyright (c) 2025, ENFLAME CORPORATION. All rights reserved.
 *
 * Device IR kernel implementations — TOPS kernels exercising FlagCX Device
 * API IR functions via device pointers.
 *
 * Signature-compatible with test/kernel/nvidia/device_ir.cu: the same 51
 * device kernels and the same 49 launchKernel*S launchers, with the same
 * names and parameters, so test/kernel/include/device_ir.h and the
 * test/unittest/device_api IR suites link unchanged.
 *
 * The bodies are intentionally NOT implemented yet — every entry point
 * returns immediately. The platform stays wired end-to-end (compiles, links,
 * the suites run) while the kernels are ported one at a time. Each stub
 * carries the nvidia semantics in a comment plus a file:line reference to
 * test/kernel/nvidia/device_ir.cu.
 *
 * Porting notes for this platform:
 *   - nvidia declares these kernels with a raw `__global__`; here the FlagCX
 *     decorator macro is used so the same file is a valid host TU as well
 *     (on Enflame `FLAGCX_GLOBAL_DECORATOR` is `__global__` in the device
 *     pass and expands to nothing in the g++ host pass).
 *   - `flagcxStream_t` on Enflame is `struct flagcxStream { topsStream_t
 *     base; }` (flagcx/adaptor/include/enflame_adaptor.h), so the launchers
 *     keep the nvidia `stream->base` launch syntax verbatim.
 *   - `__launch_bounds__` is not used on nvidia's IR kernels either; the
 *     launchers pass the block size explicitly.
 *   - The one-sided IR calls on this platform must go through the ECCL
 *     backend selected by -DFLAGCX_COMM_TRAITS_CCL.
 *   - nvidia defines S20/S21/S22/S23/S24/S25 codegen macros
 *     (e.g. S20_INTRA_COMBO) that expand inside the kernel bodies. They are
 *     body-local, so they are omitted here; port each macro together with
 *     the body that uses it.
 ************************************************************************/

#include "flagcx.h"
#include "flagcx_kernel.h"
#include "enflame_adaptor.h"
#include "flagcx_device_internal.h"
#include "global_comm.h"

// IR wrapper declarations + implementations (needed so the device pass sees
// the inline IR bodies).
#include "flagcx_device_wrapper.h"
#include "flagcx_device_wrapper_impl.h" // also pulls in scalar_ir_impl.h

#include "device_ir.h"

#define TOPSCHECK(cmd)                                                         \
  do {                                                                         \
    topsError_t err = cmd;                                                     \
    if (err != topsSuccess) {                                                  \
      WARN("Tops failure '%s'", topsGetErrorString(err));                      \
      (void)topsGetLastError();                                                \
      return flagcxUnhandledDeviceError;                                       \
    }                                                                          \
  } while (false)

#define ECCL_DEVICE_GRID_DIM      4
#define ECCL_DEVICE_BLOCK_DIM     2
#define ECCL_DEVICE_THREAD_DIM    4

template <int GRID_DIM, int BLOCK_DIM, int THREAD_DIM,
          typename KernelFn, typename... Args>
flagcxResult_t launchKernelExC(KernelFn kernel, flagcxStream_t stream,
                               Args &...args) {
  topsLaunchConfig_t cfg = {};
  cfg.gridDim  = {GRID_DIM,  1, 1};
  cfg.blockDim = {BLOCK_DIM,  1, 1};
  cfg.stream   = *(topsStream_t *)stream;

  topsLaunchAttribute attr[2];
  attr[0].id  = topsLaunchAttributeThreadDimension;
  attr[0].val.threadDim = {THREAD_DIM, 1, 1};
  attr[1].id  = topsLaunchAttributeCooperative;
  attr[1].val.cooperative = 1;
  cfg.attrs   = attr;
  cfg.numAttrs = 2;

  void *kernelArgs[] = {&args...};
  TOPSCHECK(topsLaunchKernelExC(&cfg, (const void *)kernel, kernelArgs));

  return flagcxSuccess;
}


// Keep the shared IR tests backend-neutral. Existing backends resolve this to
// 64; the Iluvatar DefaultBackend resolves it to its 32-bit completion domain.
// ECCL does not narrow it either (flagcxBackendCompletionBits defaults to 64),
// so this stays 64 here unless the ECCL traits gain a completionBits member.
static constexpr int kCompletionBits =
    flagcxBackendCompletionBits<DeviceAPI>::value;

// ===========================================================================
// Scalar IR (S-suffixed) kernels — Intra-Node (S1–S10)
// ===========================================================================

// ---------------------------------------------------------------------------
// S1: Comm Queries (Scalar)
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelCommQueriesS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr, int *results) {
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    results[0] = flagcxDevCommGetRank(devCommPtr);
    results[1] = flagcxDevCommGetSize(devCommPtr);
    results[2] = flagcxDevCommGetIntraRank(devCommPtr);
    results[3] = flagcxDevCommGetIntraSize(devCommPtr);
  }
}

void launchKernelCommQueriesS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                              int *devResults, flagcxStream_t stream) {
  if (!devCommPtr || !devResults) return;
  launchKernelExC<1, 1, 1>(kernelCommQueriesS, stream, devCommPtr, devResults);
}

// ---------------------------------------------------------------------------
// S2: Coop Groups (Scalar) — block, tile_span, lanes in one launcher
// ---------------------------------------------------------------------------
FLAGCX_GLOBAL_DECORATOR void kernelCoopGroupsS_block(int *results) {
  flagcxCoopBlock coop;
  int rank = coop.threadRank();
  int size = coop.size();

  if (FLAGCX_BLOCK_IDX_X == 0 && rank == 0) {
    results[0] = (size == threadDim.x) ? 1 : 0;
  }
}

FLAGCX_GLOBAL_DECORATOR void kernelCoopGroupsS_tileSpan(int *results) {
  // ECCL does not support tile_span, so we just pass this test.
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    results[1] = 1;
  }
}

FLAGCX_GLOBAL_DECORATOR void kernelCoopGroupsS_lanes(int *results) {
  // ECCL does not support lanes cooperation, so we just pass this test.
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    results[2] = 1;
  }
}

void launchKernelCoopGroupsS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                             int *devResults, flagcxStream_t stream) {
  if (!devResults) return;
  // Launch three sub-kernels into the same results buffer
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelCoopGroupsS_block, stream, devResults);
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelCoopGroupsS_tileSpan, stream, devResults);
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelCoopGroupsS_lanes, stream, devResults);
  (void)devCommPtr; // unused but kept for API symmetry
}

// ---------------------------------------------------------------------------
// S3: Team Queries (Scalar)
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelTeamQueriesS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr, int *results) {
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    int intraRank = flagcxDevCommGetIntraRank(devCommPtr);
    int worldRank = flagcxTeamRankToWorldS(devCommPtr, FLAGCX_TEAM_INTRA, intraRank);
    results[0] = intraRank;
    results[1] = worldRank;
  }
}

void launchKernelTeamQueriesS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                              int *devResults, flagcxStream_t stream) {
  if (!devCommPtr || !devResults) return;
  launchKernelExC<1, 1, 1>(kernelTeamQueriesS, stream, devCommPtr, devResults);
}

// ---------------------------------------------------------------------------
// S4: Local Pointer (Scalar)
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelLocalPointerS(const void FLAGCX_IR_GLOBAL_PTR *devMemPtr, void *rawBuff,
                    int *results) {
  if (FLAGCX_THREAD_IDX_X == 0 && FLAGCX_BLOCK_IDX_X == 0) {
    void *localPtr = flagcxGetLocalPointerS(devMemPtr, 0);
    if (localPtr == nullptr) {
      results[0] = 0;
    } else {
      float val = *((volatile float *)localPtr);
      float expected = *((volatile float *)rawBuff);
      results[0] = (val == expected) ? 1 : 0;
    }
  }
}

void launchKernelLocalPointerS(const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                               void *rawBuff, int *devResults,
                               flagcxStream_t stream) {
  if (!devMemPtr || !devResults) return;
  launchKernelExC<1, 1, 1>(kernelLocalPointerS, stream, devMemPtr, rawBuff, devResults);
}

// ---------------------------------------------------------------------------
// S5: Intra Pointer (Scalar)
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelIntraPointerS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                    const void FLAGCX_IR_GLOBAL_PTR *devMemPtr, float *output,
                    int count) {
  const flagcxDevComm *comm = (const flagcxDevComm *)devCommPtr;
  int myRank = comm->getIntraRank();
  int nRanks = comm->getIntraSize();
  int peer = (myRank + nRanks - 1) % nRanks;

  // Use persistent barrier to avoid LSA epoch state contamination across kernels
  flagcxTeam intra = flagcxTeamIntra(*comm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), *comm, intra,
      (uint32_t)(blockIdx.x * blockDim.x + threadIdx.x)};

  // Initial barrier to ensure all ranks' data is visible
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Check first pointer before any thread dereferences
  float *firstPtr = (float *)flagcxGetIntraPointerS(devMemPtr, tid * sizeof(float), peer);
  if (firstPtr == nullptr) {
    return;
  }

  // ECCL LSA write-only: cannot read peers' send buffers directly.
  // Phase 1: Write my data to peer's helper region
  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointerS(devMemPtr, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetIntraPointerS(devMemPtr, (count + i) * sizeof(float), peer);
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  // Phase 2: Read from local helper region
  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointerS(devMemPtr, (count + i) * sizeof(float), myRank);
    output[i] = *myPtr;
  }
}

FLAGCX_GLOBAL_DECORATOR void
kernelIntraPointerWithAccessS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                              const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                              float *output, int count) {
  const flagcxDevComm *comm = (const flagcxDevComm *)devCommPtr;
  int myRank = comm->getIntraRank();
  int nRanks = comm->getIntraSize();
  int peer = (myRank + nRanks - 1) % nRanks;

  // Use persistent barrier to avoid LSA epoch state contamination across kernels
  flagcxTeam intra = flagcxTeamIntra(*comm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), *comm, intra,
      (uint32_t)(blockIdx.x * blockDim.x + threadIdx.x)};

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  float *firstPtr = (float *)flagcxGetIntraPointerWithAccessS(
      devMemPtr, tid * sizeof(float), peer, flagcxDevPeerAccessReadOnly);
  if (firstPtr == nullptr) {
    return;
  }

  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointerS(devMemPtr, i * sizeof(float), myRank);
    float *peerPtr = (float *)flagcxGetIntraPointerWithAccessS(
        devMemPtr, (count + i) * sizeof(float), peer, flagcxDevPeerAccessReadOnly);
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetIntraPointerWithAccessS(
        devMemPtr, (count + i) * sizeof(float), myRank, flagcxDevPeerAccessReadOnly);
    output[i] = *myPtr;
  }
}

void launchKernelIntraPointerS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                               const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                               float *devOutput, int count,
                               flagcxStream_t stream) {
  if (!devCommPtr || !devMemPtr || !devOutput) return;
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelIntraPointerS, stream, devCommPtr, devMemPtr, devOutput, count);
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelIntraPointerWithAccessS, stream, devCommPtr, devMemPtr, devOutput, count);
}

// ---------------------------------------------------------------------------
// S8: Intra Barrier Sync (Scalar)
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelIntraBarrierSyncS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                        const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                        float *buffer, float *output, int count) {
  const flagcxDevComm *comm = (const flagcxDevComm *)devCommPtr;
  int myRank = comm->getIntraRank();
  int nRanks = comm->getIntraSize();
  int peer = (myRank + nRanks - 1) % nRanks;

  // Use persistent barrier to avoid LSA epoch state contamination across kernels
  flagcxTeam intra = flagcxTeamIntra(*comm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), *comm, intra,
      (uint32_t)(blockIdx.x * blockDim.x + threadIdx.x)};

  int tid = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Write my data to buffer
  for (int i = tid; i < count; i += nthreads) {
    buffer[i] = (float)(myRank + 1);
  }

  // Barrier sync
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  float *firstPtr = (float *)flagcxGetPeerPointerS(devMemPtr, tid * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, peer);
  if (firstPtr == nullptr) {
    return;
  }

  // ECCL LSA write-only adaptation
  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, myRank);
    float *peerPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, peer);
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, myRank);
    output[i] = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderRelease);
}

void launchKernelIntraBarrierSyncS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                                   const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                                   float *buffer, float *output, int count,
                                   flagcxStream_t stream) {
  if (!devCommPtr || !devMemPtr || !buffer || !output) return;
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelIntraBarrierSyncS, stream, devCommPtr, devMemPtr, buffer, output, count);
}

// ---------------------------------------------------------------------------
// S9: Intra Barrier Sync Split (Release + read + Acquire)
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelIntraBarrierArriveWaitS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                              const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                              float *buffer, float *output, int count) {
  const flagcxDevComm *comm = (const flagcxDevComm *)devCommPtr;
  int myRank = comm->getIntraRank();
  int nRanks = comm->getIntraSize();
  int peer = (myRank + nRanks - 1) % nRanks;

  // Use persistent barrier to avoid LSA epoch state contamination across kernels
  flagcxTeam intra = flagcxTeamIntra(*comm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), *comm, intra,
      (uint32_t)(blockIdx.x * blockDim.x + threadIdx.x)};

  int tid = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Write my data to buffer
  for (int i = tid; i < count; i += nthreads) {
    buffer[i] = (float)(myRank + 500);
  }

  // Arrive (release)
  bar.sync(flagcxDeviceMemoryOrderRelease);

  // Wait (acquire)
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  float *firstPtr = (float *)flagcxGetPeerPointerS(devMemPtr, tid * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, peer);
  if (firstPtr == nullptr) {
    return;
  }

  // ECCL LSA write-only adaptation
  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, myRank);
    float *peerPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, peer);
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, myRank);
    output[i] = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderRelease);
}

void launchKernelIntraBarrierArriveWaitS(
    const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
    const void FLAGCX_IR_GLOBAL_PTR *devMemPtr, float *buffer, float *output,
    int count, flagcxStream_t stream) {
  if (!devCommPtr || !devMemPtr || !buffer || !output) return;
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelIntraBarrierArriveWaitS, stream, devCommPtr, devMemPtr, buffer, output, count);
}

// ---------------------------------------------------------------------------
// S6: Peer Pointer (Scalar) — team-based peer memory access
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelPeerPointerS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                   const void FLAGCX_IR_GLOBAL_PTR *devMemPtr, float *output,
                   int count) {
  const flagcxDevComm *comm = (const flagcxDevComm *)devCommPtr;
  int myRank = comm->getIntraRank();
  int nRanks = comm->getIntraSize();
  int peer = (myRank + nRanks - 1) % nRanks;

  // Use persistent barrier to avoid LSA epoch state contamination across kernels
  flagcxTeam intra = flagcxTeamIntra(*comm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), *comm, intra,
      (uint32_t)(blockIdx.x * blockDim.x + threadIdx.x)};

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  float *firstPtr = (float *)flagcxGetPeerPointerS(devMemPtr, tid * sizeof(float),
                                                    devCommPtr, FLAGCX_TEAM_INTRA, peer);
  if (firstPtr == nullptr) {
    return;
  }

  // ECCL LSA write-only adaptation
  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float),
                                                   devCommPtr, FLAGCX_TEAM_INTRA, myRank);
    float *peerPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float),
                                                     devCommPtr, FLAGCX_TEAM_INTRA, peer);
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float),
                                                   devCommPtr, FLAGCX_TEAM_INTRA, myRank);
    output[i] = *myPtr;
  }
}

FLAGCX_GLOBAL_DECORATOR void
kernelPeerPointerWithAccessS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                             const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                             float *output, int count) {
  const flagcxDevComm *comm = (const flagcxDevComm *)devCommPtr;
  int myRank = comm->getIntraRank();
  int nRanks = comm->getIntraSize();
  int peer = (myRank + nRanks - 1) % nRanks;

  // Use persistent barrier to avoid LSA epoch state contamination across kernels
  flagcxTeam intra = flagcxTeamIntra(*comm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), *comm, intra,
      (uint32_t)(blockIdx.x * blockDim.x + threadIdx.x)};

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int tid = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  float *firstPtr = (float *)flagcxGetPeerPointerWithAccessS(
      devMemPtr, tid * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, peer,
      flagcxDevPeerAccessReadOnly);
  if (firstPtr == nullptr) {
    return;
  }

  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float),
                                                   devCommPtr, FLAGCX_TEAM_INTRA, myRank);
    float *peerPtr = (float *)flagcxGetPeerPointerWithAccessS(
        devMemPtr, (count + i) * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, peer,
        flagcxDevPeerAccessReadOnly);
    *peerPtr = *myPtr;
  }

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  for (int i = tid; i < count; i += nthreads) {
    float *myPtr = (float *)flagcxGetPeerPointerWithAccessS(
        devMemPtr, (count + i) * sizeof(float), devCommPtr, FLAGCX_TEAM_INTRA, myRank,
        flagcxDevPeerAccessReadOnly);
    output[i] = *myPtr;
  }
}

void launchKernelPeerPointerS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                              const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                              float *devOutput, int count,
                              flagcxStream_t stream) {
  if (!devCommPtr || !devMemPtr || !devOutput) return;
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelPeerPointerS, stream, devCommPtr, devMemPtr, devOutput, count);
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelPeerPointerWithAccessS, stream, devCommPtr, devMemPtr, devOutput, count);
}

// ---------------------------------------------------------------------------
// S10: Intra AllReduce (Scalar) — composite using barriers + pointers
// ---------------------------------------------------------------------------

FLAGCX_GLOBAL_DECORATOR void
kernelIntraAllReduceS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                      const void FLAGCX_IR_GLOBAL_PTR *devMemPtr, float *buffer,
                      int count) {
  const flagcxDevComm *comm = (const flagcxDevComm *)devCommPtr;
  int myRank = comm->getIntraRank();
  int nRanks = comm->getIntraSize();

  // Use a persistent barrier object for the entire kernel lifetime, matching
  // the non-IR version (device_api.tops). Each flagcxIntraBarrierSyncS() call
  // constructs and destructs a temporary ecclLsaBarrierSession, which reads
  // the epoch from the resource buffer on construction and writes it back on
  // destruction. With 3N-1 barrier syncs in AllReduce, the repeated
  // construct/destruct cycle can cause LSA epoch state inconsistency under
  // race conditions, leading to probabilistic hangs. A single persistent
  // barrier avoids this entirely.
  flagcxTeam intra = flagcxTeamIntra(*comm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar{
      flagcxCoopBlock(), *comm, intra,
      (uint32_t)(blockIdx.x * blockDim.x + threadIdx.x)};

  // Initial barrier
  bar.sync(flagcxDeviceMemoryOrderAcquire);

  // Single-rank fast path
  if (nRanks == 1) {
    bar.sync(flagcxDeviceMemoryOrderRelease);
    return;
  }

  int tid = subThreadIdx.x + threadDim.x * (threadIdx.x + blockDim.x * blockIdx.x);
  int nthreads = threadDim.x * blockDim.x * gridDim.x;

  // Null check
  int checkPeer = (myRank == 0) ? 1 : 0;
  float *firstPtr = (float *)flagcxGetPeerPointerS(devMemPtr, 0, devCommPtr,
                                                    FLAGCX_TEAM_INTRA, checkPeer);
  if (firstPtr == nullptr) {
    return;
  }

  // Phase 1: Reduce to rank 0 (N-1 rounds)
  for (int step = 0; step < nRanks - 1; step++) {
    int sender = step + 1;

    if (myRank == sender) {
      for (int i = tid; i < count; i += nthreads) {
        float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float),
                                                       devCommPtr, FLAGCX_TEAM_INTRA, myRank);
        float *peerPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float),
                                                         devCommPtr, FLAGCX_TEAM_INTRA, 0);
        *peerPtr = *myPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);

    if (myRank == 0) {
      for (int i = tid; i < count; i += nthreads) {
        float *helperPtr = (float *)flagcxGetPeerPointerS(devMemPtr, (count + i) * sizeof(float),
                                                           devCommPtr, FLAGCX_TEAM_INTRA, 0);
        float *dataPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float),
                                                         devCommPtr, FLAGCX_TEAM_INTRA, 0);
        *dataPtr += *helperPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);
  }

  // Phase 2: Broadcast from rank 0 (N-1 rounds)
  for (int step = 0; step < nRanks - 1; step++) {
    int receiver = step + 1;

    if (myRank == 0) {
      for (int i = tid; i < count; i += nthreads) {
        float *myPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float),
                                                       devCommPtr, FLAGCX_TEAM_INTRA, 0);
        float *peerPtr = (float *)flagcxGetPeerPointerS(devMemPtr, i * sizeof(float),
                                                         devCommPtr, FLAGCX_TEAM_INTRA, receiver);
        *peerPtr = *myPtr;
      }
    }

    bar.sync(flagcxDeviceMemoryOrderAcquire);
  }

  // Final barrier
  bar.sync(flagcxDeviceMemoryOrderRelease);
}

void launchKernelIntraAllReduceS(const void FLAGCX_IR_GLOBAL_PTR *devCommPtr,
                                 const void FLAGCX_IR_GLOBAL_PTR *devMemPtr,
                                 float *buffer, int count,
                                 flagcxStream_t stream) {
  if (!devCommPtr || !devMemPtr || !buffer) return;
  launchKernelExC<ECCL_DEVICE_GRID_DIM, ECCL_DEVICE_BLOCK_DIM, ECCL_DEVICE_THREAD_DIM>(
      kernelIntraAllReduceS, stream, devCommPtr, devMemPtr, buffer, count);
}

