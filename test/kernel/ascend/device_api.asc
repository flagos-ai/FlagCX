/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * FlagCX Device API kernels — Ascend (CANN).
 *
 * Stage 2 content is deliberately narrow: it is the toolchain smoke gate, not
 * the acceptance suite. What this file has to prove, measured on Ascend 910C
 * (soc Ascend910_9382, __NPU_ARCH__ 2201, CANN 9.1.0-beta.3):
 *   1. FlagCX's Device API headers instantiate on the bisheng aicore pass —
 *      the include set below is the same one the reference vendor kernels
 *      use, so anything that breaks here breaks for the stage-3 port too;
 *   2. a device translation unit built from the Ascend platform traits links
 *      into libflagcx without a separate device-link step;
 *   3. block-scope scratch through __ubuf__ reaches global memory, and a
 *      by-value struct carrying unqualified pointers really addresses it: a
 *      kernel launched from the host half of a translation unit stored 10 and
 *      11 through such a member and aclrtMemcpy read them back (probe RP,
 *      "OUT 10 11 0 0");
 *   4. the atomic layer code-generates for the half this toolchain can emit.
 *      load and store are volatile accesses through plain pointers, and this
 *      kernel lowers them for real. The read-modify-write half is not
 *      reachable on 2201 at all (three independent measurements, recorded in
 *      ascend_platform_traits.h), so those members expand to a call to a
 *      function that is declared and never defined — naming one here would
 *      leave an undefined reference in the gate object, which is exactly the
 *      behaviour a stage-3 kernel must not be able to paper over. That
 *      refusal is verified out of band (probe series of 2026-11-10) rather
 *      than in the gate, and the reason it is not a compile error is that
 *      bisheng has no selectable trap either: __builtin_trap() lowers to a
 *      call to abort and the CCE back end rejects it outright (probes T0/T1).
 *
 * The T1-T4 kernel set (intra-node AllReduce over IPC peer pointers, inter-node
 * put/signal/flush, the eight one-sided facets) is stage 3; it arrives as a
 * port of the reference implementation, whose body is already written against
 * the FLAGCX_* macros in device_utils.h rather than against vendor builtins.
 *
 * Nothing here claims a capability the platform does not have: there is no
 * warp/lane code (Ascend 910C rejects the SIMT entry model, see the note in
 * device_utils.h), no fence and no named barrier.
 ************************************************************************/

#include "device_api/flagcx_device.h"
#include "ascend_adaptor.h"
#include "flagcx_kernel.h"
#include "global_comm.h"

// Datatype size helper, shared shape with the other vendor test kernels.
FLAGCX_DEVICE_DECORATOR size_t
getFlagcxDataTypeSizeDevice(flagcxDataType_t dtype) {
  switch (dtype) {
    case flagcxChar:
      return sizeof(char);
    case flagcxUint8:
      return sizeof(unsigned char);
    case flagcxInt:
      return sizeof(int);
    case flagcxUint32:
      return sizeof(unsigned int);
    case flagcxInt64:
      return sizeof(long long);
    case flagcxUint64:
      return sizeof(unsigned long long);
    case flagcxHalf:
      return 2;
    case flagcxFloat:
      return sizeof(float);
    case flagcxDouble:
      return sizeof(double);
    default:
      return 0;
  }
}

// Toolchain smoke: __ubuf__ staging buffer -> global memory. Runs on one AI
// core; the value it writes is what the stage gate checks. This kernel is the
// one place where a __gm__ parameter is legitimate: it is written through
// directly, and never converted to a plain pointer.
extern "C" __global__ __aicore__ void flagcxDevApiSmoke(__gm__ uint32_t *out,
                                                        uint32_t value) {
  FLAGCX_SHARED uint32_t stage[1];
  stage[0] = value;
  out[0] = stage[0];
}

// Traits smoke. Parsing the header proves nothing about code generation, so
// this kernel instantiates the atomic members the device pass can actually
// emit — store and load — on both integer widths, and writes what it reads
// back to global memory so the accesses cannot be folded away.
//
// The buffers reach the atomic layer through a BY-VALUE struct with
// unqualified pointer members, which is how the Default backend actually
// works: device_utils.h documents flagcxDevComm / flagcxDevMem as by-value
// kernel parameters precisely so that both compilation passes agree on a
// layout of plain pointers, and FLAGCX_DEVICE_GLOBAL_PTR only expands to
// __global_ptr__ on Kunlunxin. The alternative — converting a __gm__ kernel
// parameter into a plain pointer — is not available: bisheng refuses every
// address-space conversion inside an aicore function, implicit (probes B2/B3),
// named, and C-style in both spellings (probes F1/F2/F3), and has no
// __builtin_astype to opt out with (probe B4). Following the production shape
// is therefore also the only shape that compiles.
//
// fetchAdd / fetchSub / fetchOr / fetchAnd / exchange / compareExchange are
// deliberately absent, and not because they fail to parse: CceAtomic is a
// non-template class, so every one of those bodies is type-checked in every
// translation unit that includes this header, gate included. They are absent
// because *calling* one emits a reference to
// flagcxDeviceTrapUnavailableOn2201, which exists nowhere by design.
//
// Template arguments are left to deduction, as in comm_traits.h, so the
// overload selection exercised here is the one the real call sites get.
struct FlagcxAscendSmokeArgs {
  uint32_t *counters;
  uint64_t *word;
};

extern "C" __global__ __aicore__ void flagcxDevApiAtomicSmoke(
    FlagcxAscendSmokeArgs args, uint32_t seed) {
  using Atomic = PlatformTraits<AscendPlatform>::Atomic;
  const flagcxDeviceMemoryOrder_t order = flagcxDeviceMemoryOrderSeqCst;
  uint32_t *counters = args.counters;
  uint64_t *word = args.word;

  Atomic::store(counters, seed, order);
  Atomic::store(word, static_cast<uint64_t>(seed) << 32, order);
  const uint32_t reloaded = Atomic::load(counters, order);
  const uint64_t wide = Atomic::load(word, order);

  counters[1] = reloaded + static_cast<uint32_t>(wide >> 32);
}
