/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * FlagCX Device API kernels — Ascend (CANN).
 *
 * Stage 2 content is deliberately narrow: it is the toolchain smoke gate, not
 * the acceptance suite. What this file has to prove, measured on Ascend 910C
 * (soc Ascend910_9382, __NPU_ARCH__ 2201, CANN 9.1.0-beta.3):
 *   1. FlagCX's Device API headers instantiate on the bisheng aicore pass —
 *      the include set below is the same one the reference vendor kernels
 *      use, so anything that breaks here breaks for the stage-3 port too;
 *   2. a device translation unit built from the Ascend platform traits links
 *      into libflagcx without a separate device-link step;
 *   3. block-scope scratch through __ubuf__ reaches global memory, and a
 *      by-value struct carrying unqualified pointers really addresses it: a
 *      kernel launched from the host half of a translation unit stored 10 and
 *      11 through such a member and aclrtMemcpy read them back (probe RP,
 *      "OUT 10 11 0 0");
 *   4. every member of the Atomic contract instantiates without breaking the
 *      compiler. That is a weaker claim than "the atomics code-generate", and
 *      it is stated weakly on purpose. Read-modify-write is not reachable on
 *      this soc at all — three independent measurements, recorded in
 *      ascend_platform_traits.h — so the RMW members compile to the
 *      declared-unsupported trap instead. Naming them here is what proves the
 *      trap path is instantiable: the previous version of this kernel passed
 *      the atomics through to __builtin_cce_atom_*, which made bisheng
 *      segfault in instruction selection rather than report anything.
 *
 * The T1-T4 kernel set (intra-node AllReduce over IPC peer pointers, inter-node
 * put/signal/flush, the eight one-sided facets) is stage 3; it arrives as a
 * port of the reference implementation, whose body is already written against
 * the FLAGCX_* macros in device_utils.h rather than against vendor builtins.
 *
 * Nothing here claims a capability the platform does not have: there is no
 * warp/lane code (Ascend 910C rejects the SIMT entry model, see the note in
 * device_utils.h), no fence and no named barrier. The kernel in item 4
 * performs no synchronization and is not meant to be run — it exists so the
 * compile gate can name the whole contract. Where the contract has a working
 * half on this toolchain (load and store, which are volatile accesses through
 * the unqualified pointers the by-value parameters carry) the values it writes
 * are stored for real, so the file also serves as the shape a stage-3 kernel
 * must launch.
 ************************************************************************/

#include "device_api/flagcx_device.h"
#include "ascend_adaptor.h"
#include "flagcx_kernel.h"
#include "global_comm.h"

// Datatype size helper, shared shape with the other vendor test kernels.
FLAGCX_DEVICE_DECORATOR size_t
getFlagcxDataTypeSizeDevice(flagcxDataType_t dtype) {
  switch (dtype) {
    case flagcxChar:
      return sizeof(char);
    case flagcxUint8:
      return sizeof(unsigned char);
    case flagcxInt:
      return sizeof(int);
    case flagcxUint32:
      return sizeof(unsigned int);
    case flagcxInt64:
      return sizeof(long long);
    case flagcxUint64:
      return sizeof(unsigned long long);
    case flagcxHalf:
      return 2;
    case flagcxFloat:
      return sizeof(float);
    case flagcxDouble:
      return sizeof(double);
    default:
      return 0;
  }
}

// Toolchain smoke: __ubuf__ staging buffer -> global memory. Runs on one AI
// core; the value it writes is what the stage gate checks. This kernel is the
// one place where a __gm__ parameter is legitimate: it is written through
// directly, and never converted to a plain pointer.
extern "C" __global__ __aicore__ void flagcxDevApiSmoke(__gm__ uint32_t *out,
                                                        uint32_t value) {
  FLAGCX_SHARED uint32_t stage[1];
  stage[0] = value;
  out[0] = stage[0];
}

// Traits smoke. Parsing the header proves nothing about code generation, so
// this kernel instantiates every Atomic member the contract has: store, load,
// fetchAdd, fetchSub, fetchOr, fetchAnd, exchange, compareExchange. They are
// function templates, so an unsupported spelling or a pattern the back end
// cannot select only shows up here — which is exactly how the atomic gap was
// found (see ascend_platform_traits.h).
//
// The buffers reach the atomic layer through a BY-VALUE struct with
// unqualified pointer members, which is how the Default backend actually
// works: device_utils.h:62-66 documents flagcxDevComm / flagcxDevMem as
// by-value kernel parameters precisely so that both compilation passes agree
// on a layout of plain pointers, and FLAGCX_DEVICE_GLOBAL_PTR only expands to
// __global_ptr__ on Kunlunxin (:46-52). The alternative — converting a __gm__
// kernel parameter into a plain pointer — is not available: bisheng refuses
// every address-space conversion inside an aicore function, implicit
// (probes B2/B3), named, and C-style in both spellings (probes F1/F2/F3), and
// has no __builtin_astype to opt out with (probe B4). Following the production
// shape is therefore also the only shape that compiles.
//
// Template arguments are left to deduction, as in comm_traits.h, so the
// overload selection exercised here is the one the real call sites get.
struct FlagcxAscendSmokeArgs {
  uint32_t *counters;
  uint64_t *word;
};

extern "C" __global__ __aicore__ void flagcxDevApiAtomicSmoke(
    FlagcxAscendSmokeArgs args, uint32_t seed) {
  using Atomic = PlatformTraits<AscendPlatform>::Atomic;
  const flagcxDeviceMemoryOrder_t order = flagcxDeviceMemoryOrderSeqCst;
  uint32_t *counters = args.counters;
  uint64_t *word = args.word;

  Atomic::store(counters, seed, order);
  const uint32_t added = Atomic::fetchAdd(counters, 1u, order);
  const uint32_t subbed = Atomic::fetchSub(counters, 1u, order);
  const uint32_t ored = Atomic::fetchOr(counters, 2u, order);
  const uint32_t anded = Atomic::fetchAnd(counters, 0xfeu, order);
  const uint32_t swapped = Atomic::exchange(counters, 1u, order);
  uint32_t expected = seed;
  const bool passed = Atomic::compareExchange(counters, expected, 2u, order);
  const uint64_t loaded = Atomic::load(word, order);

  counters[1] = added + subbed + ored + anded + swapped +
                static_cast<uint32_t>(loaded) + (passed ? 1u : 0u);
}
