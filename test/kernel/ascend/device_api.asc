/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * FlagCX Device API kernels — Ascend (CANN).
 *
 * Stage 2 content is deliberately narrow: it is the toolchain smoke gate, not
 * the acceptance suite. What this file has to prove, measured on Ascend 910C
 * (soc Ascend910_9382, __NPU_ARCH__ 2201, CANN 9.1.0-beta.3):
 *   1. FlagCX's Device API headers instantiate on the bisheng aicore pass —
 *      the include set below is the same one the reference vendor kernels
 *      use, so anything that breaks here breaks for the stage-3 port too;
 *   2. a device translation unit built from the Ascend platform traits links
 *      into libflagcx without a separate device-link step;
 *   3. block-scope scratch through __ubuf__ reaches global memory, and a
 *      by-value struct carrying unqualified pointers really addresses it: a
 *      kernel launched from the host half of a translation unit stored 10 and
 *      11 through such a member and aclrtMemcpy read them back (probe RP,
 *      "OUT 10 11 0 0").
 *
 * What this file does NOT contain, on purpose: no call to the Ascend device
 * Atomic layer at any memory order. CceAtomic's load, store and every
 * read-modify-write member are declared-absent capabilities on this pass — the
 * volatile accesses that load/store used to be do not provide the acquire or
 * release that default_comm_traits.h asks for (:574 AcqRel, :580 Acquire, :858
 * Release), and the review decision on PR #705 (2026-11-10) is to state that
 * as unsupported here rather than ship an ordered-looking unordered access.
 * Naming any of them here would leave a reference to a function that is
 * declared and never defined in the gate object, and bisheng links the device
 * image inside -c, so the gate itself would stop building — which is the
 * behaviour a stage-3 kernel must not be able to paper over. The refusal is
 * therefore verified out of band (probe series of 2026-11-10), and it is not a
 * compile error only because bisheng has no selectable trap: __builtin_trap()
 * lowers to a call to abort and the CCE back end rejects that outright
 * (probes T0/T1).
 *
 * The ordered version, when it lands, comes from the cache-control and pipe
 * sync surfaces that this toolchain does emit on 2201 (asc_dcci_*,
 * asc_sync_data_barrier, ffts_cross_core_sync — all RC=0), after a two-core
 * producer/consumer run shows a peer core actually observes the ordering. RC=0
 * proves an instruction was selected, not that synchronization works, so none
 * of it is claimed here.
 *
 * The T1-T4 kernel set (intra-node AllReduce over IPC peer pointers, inter-node
 * put/signal/flush, the eight one-sided facets) is stage 3. Part of it has
 * landed below: the intra cases that need no peer memory and no atomic. What
 * did NOT carry over from the reference port is the launcher shape — see the
 * note above the launchers, it is a measured difference, not a preference.
 *
 * Nothing here claims a capability the platform does not have: there is no
 * warp/lane code (Ascend 910C rejects the SIMT entry model, see the note in
 * device_utils.h), no fence, no block barrier and no atomic.
 ************************************************************************/

#include "device_api.h"
#include "device_api/flagcx_device.h"
#include "ascend_adaptor.h"
#include "flagcx_kernel.h"
#include "global_comm.h"

// Datatype size helper, shared shape with the other vendor test kernels.
FLAGCX_DEVICE_DECORATOR size_t
getFlagcxDataTypeSizeDevice(flagcxDataType_t dtype) {
  switch (dtype) {
    case flagcxChar:
      return sizeof(char);
    case flagcxUint8:
      return sizeof(unsigned char);
    case flagcxInt:
      return sizeof(int);
    case flagcxUint32:
      return sizeof(unsigned int);
    case flagcxInt64:
      return sizeof(long long);
    case flagcxUint64:
      return sizeof(unsigned long long);
    case flagcxHalf:
      return 2;
    case flagcxFloat:
      return sizeof(float);
    case flagcxDouble:
      return sizeof(double);
    default:
      return 0;
  }
}

// Toolchain smoke: __ubuf__ staging buffer -> global memory. Runs on one AI
// core; the value it writes is what the stage gate checks. This kernel is the
// one place where a __gm__ parameter is legitimate: it is written through
// directly, and never converted to a plain pointer.
extern "C" __global__ __aicore__ void flagcxDevApiSmoke(__gm__ uint32_t *out,
                                                        uint32_t value) {
  FLAGCX_SHARED_DECORATOR uint32_t stage[1];
  stage[0] = value;
  out[0] = stage[0];
}

// ===========================================================================
// Stage 3, part 1 — the intra-node cases that need neither peer memory nor an
// atomic: comm queries, team algebra, local pointer.
//
// The launcher shape here is NOT the reference one, and the reason is a
// measurement rather than a preference.  On the Ascend pass
// FLAGCX_HOST_DEVICE_INLINE expands to `__aicore__ inline`
// (flagcx/adaptor/include/device_utils.h:403), so every Device API handle
// constructor -- flagcxDevMem(const flagcxDevMemInternal &),
// flagcx_device_core.h:166, and flagcxDevComm(const flagcxDevCommInternal &),
// :105 -- is a device function.  The reference host half writes
// `flagcxDevMem dm(*devMem);` before it launches; on this toolchain that is
// refused outright, "candidate function not viable: call to __aicore__
// function from __host__ function" (probe r98a, 910C at e2d9602, rc=1 on two
// independent fragments, no object produced).  Probe r99a then measured the
// shape that does build -- rc=0, the launcher present as a defined symbol
// (`nm -C` -> " T launchKernelCommQueries") and three .aicore sections in the
// object (`readelf -S`): the host half hands the kernel a POD struct of
// internal pointers and the handles are constructed inside the kernel.
// flagcxDevMem_t and flagcxDevComm_t already are those pointer types
// (flagcx/include/flagcx_device_api.h), so the host half needs no cast.  This
// is the shape the library itself uses, see
// flagcx/adaptor/kernel/ascend/device_api_host_helpers.asc.
//
// The launch configuration is the one verified there as well:
// <<<1, (void *)0, (void *)stream>>> -- one block, the second slot being the
// shared-memory descriptor and the third the stream (aclrtStream is a typedef
// of void*).
//
// What deliberately stays out of this file, because the platform cannot
// satisfy it rather than because it is inconvenient:
//   * launchKernelCoopGroups asserts a 256-thread cooperative group.  Here
//     CoopBlock::size() is 1 and threadRank() is 0
//     (flagcx/adaptor/include/device_api/ascend_platform_traits.h:598-602),
//     CoopTile<N> static_asserts N==1 (:604-615), and
//     CoopLanes::sync()/CoopTileSpan::sync() resolve to
//     FLAGCX_ASCEND_UNSUPPORTED (:625-645) -- a group that reports a size it
//     cannot populate is rejected, not stubbed.
//   * launchKernelIntraPointer / launchKernelPeerPointer read a peer rank's
//     memory, and launchKernelIntraBarrierSync /
//     launchKernelIntraBarrierArriveWait / launchKernelIntraAllReduce first
//     synchronise ranks.  That barrier is built on the atomic layer this pass
//     declares absent (struct CceAtomic, ascend_platform_traits.h:201, whose
//     ordered load/store reject at :250 and :274 and whose
//     add/sub/bitOr/bitAnd/exch/cas reject at :439-488), so those cases wait
//     on peer-memory and atomic support, not on a launcher body.
//   test/unittest/device_api/Makefile compiles those cases out on this
//   platform instead of letting a stub report them as passing.
//
// One thing still unmeasured, so it is not claimed below: a failed launch
// cannot be observed from this translation unit.  There is no counterpart to
// cudaGetLastError() wired in here, and pulling acl/acl.h into a device pass
// that does not need it is what this file has avoided all along.  These
// launchers therefore return flagcxSuccess once the launch has been issued; a
// kernel that never started shows up as a failing case, not as a launch error.
// ===========================================================================

// Comm queries (test_device_api_intra K1).
struct FlagcxAscendCommQueryArgs {
  flagcxDevMemInternal *mem;
  flagcxDevCommInternal *comm;
  int *results;
};

extern "C" __global__ __aicore__ void flagcxAscendCommQueriesKernel(
    FlagcxAscendCommQueryArgs args) {
  flagcxDevMem devMem(*args.mem);
  flagcxDevComm devComm(*args.comm);
  args.results[0] = devMem.hasWindow() ? 1 : 0;
  args.results[1] = devComm.getIntraRank();
  args.results[2] = devComm.getIntraSize();
  args.results[3] = devComm.getRank();
  args.results[4] = devComm.getSize();
  args.results[5] = (devMem.getDevPeerPtrs() != nullptr) ? 1 : 0;
}

flagcxResult_t launchKernelCommQueries(flagcxDevMem_t devMem,
                                       flagcxDevComm_t devComm, int *results,
                                       flagcxStream_t stream) {
  if (devMem == nullptr || devComm == nullptr || results == nullptr)
    return flagcxInternalError;
  FlagcxAscendCommQueryArgs args;
  args.mem = devMem;
  args.comm = devComm;
  args.results = results;
  flagcxAscendCommQueriesKernel<<<1, (void *)0, (void *)stream>>>(args);
  return flagcxSuccess;
}

// Team algebra on the intra team (test_device_api_intra K3).
struct FlagcxAscendTeamArgs {
  flagcxDevCommInternal *comm;
  int *results;
};

extern "C" __global__ __aicore__ void flagcxAscendTeamKernel(
    FlagcxAscendTeamArgs args) {
  flagcxDevComm devComm(*args.comm);
  const int myRank = devComm.getIntraRank();
  const int nRanks = devComm.getIntraSize();
  flagcxTeam intra = flagcxTeamIntra(devComm);
  args.results[0] = (intra.nRanks() == nRanks) ? 1 : 0;
  // One node: the intra team is the world, so both conversions are identity.
  args.results[1] =
      (flagcxTeamRankToWorld(devComm, intra, myRank) == myRank) ? 1 : 0;
  args.results[2] =
      (flagcxTeamRankToIntra(devComm, intra, myRank) == myRank) ? 1 : 0;
  args.results[3] = flagcxTeamRankIsMember(intra, intra, myRank) ? 1 : 0;
}

flagcxResult_t launchKernelTeam(flagcxDevComm_t devComm, int *results,
                                flagcxStream_t stream) {
  if (devComm == nullptr || results == nullptr) return flagcxInternalError;
  FlagcxAscendTeamArgs args;
  args.comm = devComm;
  args.results = results;
  flagcxAscendTeamKernel<<<1, (void *)0, (void *)stream>>>(args);
  return flagcxSuccess;
}

// Local pointer through the window layer (test_device_api_intra K4).
struct FlagcxAscendLocalPtrArgs {
  flagcxDevMemInternal *mem;
  void *rawPtr;
  int *results;
};

extern "C" __global__ __aicore__ void flagcxAscendLocalPointerKernel(
    FlagcxAscendLocalPtrArgs args) {
  flagcxDevMem devMem(*args.mem);
  void *localPtr = flagcxGetLocalPointer(devMem, 0);
  if (localPtr == nullptr) {
    args.results[0] = 0;
    return;
  }
  // Plain volatile loads, deliberately: an ordering guarantee would need the
  // atomic layer this platform declares absent, and none is required here --
  // the host wrote the value and synchronised its stream before launching.
  const float viaLocal = *(volatile float *)localPtr;
  const float viaRaw = *(volatile float *)args.rawPtr;
  args.results[0] = (viaLocal == viaRaw) ? 1 : 0;
}

flagcxResult_t launchKernelLocalPointer(flagcxDevMem_t devMem, void *rawPtr,
                                        int *results, flagcxStream_t stream) {
  if (devMem == nullptr || rawPtr == nullptr || results == nullptr)
    return flagcxInternalError;
  FlagcxAscendLocalPtrArgs args;
  args.mem = devMem;
  args.rawPtr = rawPtr;
  args.results = results;
  flagcxAscendLocalPointerKernel<<<1, (void *)0, (void *)stream>>>(args);
  return flagcxSuccess;
}
