/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * FlagCX Device API kernels — Ascend (CANN).
 *
 * Stage 2 content is deliberately narrow: it is the toolchain smoke gate, not
 * the acceptance suite. What this file has to prove, measured on Ascend 910C
 * (soc Ascend910_9382, __NPU_ARCH__ 2201, CANN 9.1.0-beta.3):
 *   1. FlagCX's Device API headers instantiate on the bisheng aicore pass —
 *      the include set below is the same one the reference vendor kernels
 *      use, so anything that breaks here breaks for the stage-3 port too;
 *   2. a device translation unit built from the Ascend platform traits links
 *      into libflagcx without a separate device-link step;
 *   3. block-scope scratch through __ubuf__ reaches global memory, and a
 *      by-value struct carrying unqualified pointers really addresses it: a
 *      kernel launched from the host half of a translation unit stored 10 and
 *      11 through such a member and aclrtMemcpy read them back (probe RP,
 *      "OUT 10 11 0 0").
 *
 * What this file does NOT contain, on purpose: no call to the Ascend device
 * Atomic layer at any memory order. CceAtomic's load, store and every
 * read-modify-write member are declared-absent capabilities on this pass — the
 * volatile accesses that load/store used to be do not provide the acquire or
 * release that default_comm_traits.h asks for (:574 AcqRel, :580 Acquire, :858
 * Release), and the review decision on PR #705 (2026-11-10) is to state that
 * as unsupported here rather than ship an ordered-looking unordered access.
 * Naming any of them here would leave a reference to a function that is
 * declared and never defined in the gate object, and bisheng links the device
 * image inside -c, so the gate itself would stop building — which is the
 * behaviour a stage-3 kernel must not be able to paper over. The refusal is
 * therefore verified out of band (probe series of 2026-11-10), and it is not a
 * compile error only because bisheng has no selectable trap: __builtin_trap()
 * lowers to a call to abort and the CCE back end rejects that outright
 * (probes T0/T1).
 *
 * The ordered version, when it lands, comes from the cache-control and pipe
 * sync surfaces that this toolchain does emit on 2201 (asc_dcci_*,
 * asc_sync_data_barrier, ffts_cross_core_sync — all RC=0), after a two-core
 * producer/consumer run shows a peer core actually observes the ordering. RC=0
 * proves an instruction was selected, not that synchronization works, so none
 * of it is claimed here.
 *
 * The T1-T4 kernel set (intra-node AllReduce over IPC peer pointers, inter-node
 * put/signal/flush, the eight one-sided facets) is stage 3; it arrives as a
 * port of the reference implementation, whose body is already written against
 * the FLAGCX_* macros in device_utils.h rather than against vendor builtins.
 *
 * Nothing here claims a capability the platform does not have: there is no
 * warp/lane code (Ascend 910C rejects the SIMT entry model, see the note in
 * device_utils.h), no fence, no block barrier and no atomic.
 ************************************************************************/

#include "device_api/flagcx_device.h"
#include "ascend_adaptor.h"
#include "flagcx_kernel.h"
#include "global_comm.h"

// Datatype size helper, shared shape with the other vendor test kernels.
FLAGCX_DEVICE_DECORATOR size_t
getFlagcxDataTypeSizeDevice(flagcxDataType_t dtype) {
  switch (dtype) {
    case flagcxChar:
      return sizeof(char);
    case flagcxUint8:
      return sizeof(unsigned char);
    case flagcxInt:
      return sizeof(int);
    case flagcxUint32:
      return sizeof(unsigned int);
    case flagcxInt64:
      return sizeof(long long);
    case flagcxUint64:
      return sizeof(unsigned long long);
    case flagcxHalf:
      return 2;
    case flagcxFloat:
      return sizeof(float);
    case flagcxDouble:
      return sizeof(double);
    default:
      return 0;
  }
}

// Toolchain smoke: __ubuf__ staging buffer -> global memory. Runs on one AI
// core; the value it writes is what the stage gate checks. This kernel is the
// one place where a __gm__ parameter is legitimate: it is written through
// directly, and never converted to a plain pointer.
extern "C" __global__ __aicore__ void flagcxDevApiSmoke(__gm__ uint32_t *out,
                                                        uint32_t value) {
  FLAGCX_SHARED_DECORATOR uint32_t stage[1];
  stage[0] = value;
  out[0] = stage[0];
}
