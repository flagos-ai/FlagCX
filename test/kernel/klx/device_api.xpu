    return flagcxInvalidArgument;
  flagcxDevMem *deviceSend = nullptr;
  flagcxDevMem *deviceRecv = nullptr;
  flagcxDevComm *deviceComm = nullptr;
  flagcxResult_t result =
      flagcxDevMemGetDevicePtr(sendMem, (void **)&deviceSend);
  if (result == flagcxSuccess)
    result = flagcxDevMemGetDevicePtr(recvMem, (void **)&deviceRecv);
  if (result == flagcxSuccess)
    result = flagcxDevCommGetDevicePtr(devComm, (void **)&deviceComm);
  if (result != flagcxSuccess)
    return result;
  XPUStream cs = (XPUStream)(*(void **)stream);
  flagcxXshmemPutSignalKernel<<<1, FLAGCX_SIMT_WIDTH, cs>>>(
      deviceSend, deviceRecv, deviceComm, count, 2);
  return klxWait(cs, "put signal-add kernel");
}

flagcxResult_t
launchKernelNetCounterPipeline(flagcxDevMem_t sendMem, flagcxDevMem_t recvMem,
                               size_t count, flagcxDataType_t datatype,
                               flagcxDevComm_t devComm, flagcxStream_t stream,
                               uint64_t *resultBuf) {
  if (!sendMem || !recvMem || !devComm || !stream || !resultBuf ||
      datatype != flagcxFloat32)
    return flagcxInvalidArgument;
  flagcxDevMem *deviceSend = nullptr;
  flagcxDevMem *deviceRecv = nullptr;
  flagcxDevComm *deviceComm = nullptr;
  flagcxResult_t result =
      flagcxDevMemGetDevicePtr(sendMem, (void **)&deviceSend);
  if (result == flagcxSuccess)
    result = flagcxDevMemGetDevicePtr(recvMem, (void **)&deviceRecv);
  if (result == flagcxSuccess)
    result = flagcxDevCommGetDevicePtr(devComm, (void **)&deviceComm);
  if (result != flagcxSuccess)
    return result;
  XPUStream cs = (XPUStream)(*(void **)stream);
  flagcxXshmemCounterPipelineKernel<<<1, FLAGCX_SIMT_WIDTH, cs>>>(
      deviceSend, deviceRecv, deviceComm, count, resultBuf);
  return klxWait(cs, "counter-pipeline kernel");
}

flagcxResult_t launchKernelNetPutValue(flagcxDevMem_t recvMem,
                                       flagcxDevComm_t devComm,
                                       flagcxStream_t stream,
                                       size_t putValBase) {
  if (!recvMem || !devComm)
    return flagcxInvalidArgument;
  flagcxDevMem *deviceRecv = nullptr;
  flagcxDevComm *deviceComm = nullptr;
  flagcxResult_t result =
      flagcxDevMemGetDevicePtr(recvMem, (void **)&deviceRecv);
  if (result == flagcxSuccess)
    result = flagcxDevCommGetDevicePtr(devComm, (void **)&deviceComm);
  if (result != flagcxSuccess)
    return result;
  XPUStream cs = (XPUStream)(*(void **)stream);
  flagcxXshmemPutValueKernel<<<1, FLAGCX_SIMT_WIDTH, cs>>>(
      deviceRecv, deviceComm, putValBase);
  return klxWait(cs, "put-value kernel");
}

