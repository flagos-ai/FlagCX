namespace {

static int klxCorenum() {
  const char *e = getenv("FLAGCX_KLX_CORENUM");
  int cn = e ? atoi(e) : 16;
  if (cn < 1)
    cn = 1;
  if (cn > 16)
    cn = 16;
  return cn;
}

static flagcxResult_t klxWait(XPUStream cs, const char *where) {
  int ret = xpu_wait(cs);
  if (ret != XPU_SUCCESS) {
    fprintf(stderr, "FlagCX KLX: xpu_wait failed at %s, code=%d\n", where, ret);
    return flagcxUnhandledDeviceError;
  }
  return flagcxSuccess;
}

} // namespace

template <typename T>
__global__ void flagcxXshmemIntraAllReduceKernel(flagcxDevMem *devMem,
                                                 flagcxDevComm *devComm,
                                                 size_t count) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  if (!devMem->hasWindow())
    return;

  flagcxTeam intra = flagcxTeamIntra(*devComm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> bar(
      flagcxCoopBlock{}, *devComm, intra, cluster_id());

  bar.sync(flagcxDeviceMemoryOrderAcquire);

  int rank = devComm->getIntraRank();
  int nRanks = devComm->getIntraSize();
  size_t globalTid =
      (size_t)core_id() +
      (size_t)core_num() *
          ((size_t)rank + (size_t)cluster_id() * (size_t)nRanks);
  size_t globalNthreads = (size_t)core_num() * (size_t)cluster_num() *
                          (size_t)nRanks;

  for (size_t offset = globalTid; offset < count;
       offset += globalNthreads) {
    T value = T(0);
    for (int peer = 0; peer < nRanks; ++peer)
      value += *(T *)flagcxGetIntraPointer(*devMem, offset * sizeof(T), peer);
    for (int peer = 0; peer < nRanks; ++peer)
      *(T *)flagcxGetIntraPointer(*devMem, offset * sizeof(T), peer) = value;
  }

  bar.sync(flagcxDeviceMemoryOrderRelease);
}

flagcxResult_t launchKernelIntraAllReduce(flagcxDevMem_t devMem, size_t count,
                                          flagcxDataType_t datatype,
                                          flagcxDevComm_t devComm,
                                          flagcxStream_t stream) {
  if (devComm == nullptr || devMem == nullptr || stream == nullptr)
    return flagcxInternalError;
  if (datatype != flagcxFloat32)
    return flagcxInvalidArgument;
  if (count == 0)
    return flagcxSuccess;
  if (devMem->rawPtr == nullptr)
    return flagcxInternalError;
  if (!devMem->hasWindow || !devMem->isSymmetric)
    return flagcxInvalidArgument;
  if (devComm->intraSize < 1)
    return flagcxInvalidArgument;

  XPUStream cs = (XPUStream)(*(void **)stream);
  flagcxDevComm *deviceComm = nullptr;
  flagcxDevMem *deviceMem = nullptr;
  flagcxResult_t result =
      flagcxDevCommGetDevicePtr(devComm, (void **)&deviceComm);
  if (result != flagcxSuccess)
    return result;
  result = flagcxDevMemGetDevicePtr(devMem, (void **)&deviceMem);
  if (result != flagcxSuccess)
    return result;

  flagcxXshmemIntraAllReduceKernel<float><<<12, klxCorenum(), cs>>>(
      deviceMem, deviceComm, count);
  return klxWait(cs, "all_reduce kernel");
}

__global__ void flagcxXshmemOneSidedAlltoAllKernel(flagcxDevMem *sendMem,
                                                   flagcxDevMem *recvMem,
                                                   size_t count,
                                                   flagcxDevComm *devComm) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  XSHMEM_DEVICE_SET_FLOW_CONTROL_THRESHOLD(cluster_num());

  flagcxCoopBlock coop;
  flagcxDevNet net(*devComm, 0);
  flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> bar(
      coop, flagcxTeamTagWorld{}, net, cluster_id());

  int rank = devComm->getRank();
  int nRanks = devComm->getSize();
  size_t bytes = count * sizeof(float);
  uint64_t baseline = net.readSignal(0);

  bar.sync(flagcxDeviceMemoryOrderRelaxed);

  // XSHMEM's aligned put is a cluster collective. Assign whole peers to
  // clusters so every core in a cluster enters each put uniformly.
  for (int peer = cluster_id(); peer < nRanks; peer += cluster_num()) {
    net.put(flagcxTeamWorld(*devComm), peer, *recvMem, (size_t)rank * bytes,
            *sendMem, (size_t)peer * bytes, bytes,
            flagcxDevNet_SignalInc{0}, flagcxDevNet_None{}, coop);
  }

  net.waitSignal(coop, 0, baseline + (uint64_t)nRanks);
  net.flush(coop);

  bar.sync(flagcxDeviceMemoryOrderRelaxed);
}

flagcxResult_t launchKernelNetOneSidedAlltoAll(
    flagcxDevMem_t sendMem, flagcxDevMem_t recvMem, size_t count,
    flagcxDataType_t datatype, flagcxDevComm_t devComm, flagcxStream_t stream) {
  if (devComm == nullptr || sendMem == nullptr || recvMem == nullptr ||
      stream == nullptr)
    return flagcxInternalError;
  if (datatype != flagcxFloat32)
    return flagcxInvalidArgument;
  if (count == 0)
    return flagcxSuccess;
  if (sendMem->rawPtr == nullptr || recvMem->rawPtr == nullptr)
    return flagcxInternalError;
  if (!sendMem->hasWindow || !recvMem->hasWindow ||
      !sendMem->isSymmetric || !recvMem->isSymmetric)
    return flagcxInvalidArgument;
  if (devComm->contextCount < 1 || devComm->signalCount < 1)
    return flagcxInvalidArgument;
  if (devComm->nRanks < 1)
    return flagcxInvalidArgument;
  if (count > (size_t)-1 / sizeof(float) ||
      (size_t)devComm->nRanks > (size_t)-1 / (count * sizeof(float)))
    return flagcxInvalidArgument;

  XPUStream cs = (XPUStream)(*(void **)stream);
  flagcxDevComm *deviceComm = nullptr;
  flagcxDevMem *deviceSendMem = nullptr;
  flagcxDevMem *deviceRecvMem = nullptr;
  flagcxResult_t result =
      flagcxDevCommGetDevicePtr(devComm, (void **)&deviceComm);
  if (result != flagcxSuccess)
    return result;
  result = flagcxDevMemGetDevicePtr(sendMem, (void **)&deviceSendMem);
  if (result != flagcxSuccess)
    return result;
  result = flagcxDevMemGetDevicePtr(recvMem, (void **)&deviceRecvMem);
  if (result != flagcxSuccess)
    return result;

  int clusternum = devComm->nRanks < 12 ? devComm->nRanks : 12;
  if (clusternum < 1)
    return flagcxInvalidArgument;
  flagcxXshmemOneSidedAlltoAllKernel<<<clusternum, klxCorenum(), cs>>>(
      deviceSendMem, deviceRecvMem, count, deviceComm);
  return klxWait(cs, "all_to_all kernel");
}

#define STUB_UNUSED(x) ((void)(x))

__global__ void flagcxXshmemLocalPointerKernel(flagcxDevMem *devMem,
                                               void *rawPtr, int *results) {
  if (cluster_id() == 0 && core_id() == 0) {
    void *local = flagcxGetLocalPointer(*devMem, 0);
    results[0] = local != nullptr &&
                         *(volatile float *)local == *(volatile float *)rawPtr
                     ? 1
                     : 0;
  }
}

__global__ void flagcxXshmemCommQueriesKernel(flagcxDevMem *devMem,
                                              flagcxDevComm *devComm,
                                              int *results) {
  if (cluster_id() == 0 && core_id() == 0) {
    results[0] = devMem->hasWindow() ? 1 : 0;
    results[1] = devComm->getIntraRank();
    results[2] = devComm->getIntraSize();
    results[3] = devComm->getRank();
    results[4] = devComm->getSize();
    results[5] = devMem->getDevPeerPtrs() != nullptr ? 1 : 0;
  }
}

__global__ void flagcxXshmemCoopGroupsKernel(int *results) {
  flagcxCoopBlock block;
  if (cluster_id() == 0 && core_id() == 0)
    results[0] = block.size() == core_num() ? 1 : 0;
  block.sync();

  flagcxCoopWarp warp;
  if (cluster_id() == 0 && core_id() == 0)
    results[1] = warp.size() == FLAGCX_SIMT_WIDTH && warp.threadRank() == 0;
  warp.sync();

  flagcxCoopThread thread;
  if (cluster_id() == 0 && core_id() == 0)
    results[2] = thread.size() == 1 && thread.threadRank() == 0;

  flagcxCoopTile<8> tile;
  if (cluster_id() == 0 && core_id() == 0)
    results[3] = tile.size() == 8 && tile.threadRank() == 0;

  flagcxCoopLanes lanes((1u << FLAGCX_SIMT_WIDTH) - 1u);
  if (cluster_id() == 0 && core_id() == 0)
    results[4] = lanes.size() == FLAGCX_SIMT_WIDTH && lanes.threadRank() == 0;
  lanes.sync();
}

__global__ void flagcxXshmemTeamKernel(flagcxDevComm *devComm, int *results) {
  if (cluster_id() == 0 && core_id() == 0) {
    int rank = devComm->getIntraRank();
    flagcxTeam intra = flagcxTeamIntra(*devComm);
    results[0] = intra.nRanks() == devComm->getIntraSize();
    results[1] =
        flagcxTeamRankToWorld(*devComm, intra, rank) == devComm->getRank();
    results[2] = flagcxTeamRankToIntra(*devComm, intra, rank) == rank;
    results[3] = flagcxTeamRankIsMember(intra, intra, rank) ? 1 : 0;
  }
}

__global__ void flagcxXshmemNetGetFromCommKernel(flagcxDevComm *devComm,
                                                 int *results) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  if (cluster_id() == 0 && core_id() == 0) {
    flagcxDevNet net(*devComm, 0);
    results[0] = devComm->getContextCount() > 0 && net.isValid() ? 1 : 0;
    results[1] = devComm->getIntraSize();
  }
}

static __device__ inline void xshmemPeBarrier(DeviceAPI::CoopBlock coop) {
  coop.sync();
  if (coop.threadRank() == 0)
    xshmem_barrier_all();
  coop.sync();
}

__global__ void flagcxXshmemPutSignalKernel(flagcxDevMem *sendMem,
                                            flagcxDevMem *recvMem,
                                            flagcxDevComm *devComm,
                                            size_t count,
                                            int decoupledSignalDelta) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  DeviceAPI::CoopBlock coop;
  flagcxDevNet net(*devComm, 0);
  flagcxTeam world = flagcxTeamWorld(*devComm);
  int rank = devComm->getRank();
  int nRanks = devComm->getSize();
  size_t bytes = count * sizeof(float);
  uint64_t initial = net.readSignal(0);

  xshmemPeBarrier(coop);
  for (int peer = 0; peer < nRanks; ++peer) {
    size_t dstOffset = (size_t)rank * bytes;
    size_t srcOffset = (size_t)peer * bytes;
    if (decoupledSignalDelta != 0) {
      net.put(world, peer, *recvMem, dstOffset, *sendMem, srcOffset, bytes,
              flagcxDevNet_None{}, flagcxDevNet_None{}, flagcxCoopBlock{});
      net.flush(flagcxCoopBlock{}, flagcxDeviceMemoryOrderAcqRel);
      net.signal(world, peer,
                 flagcxDevNet_SignalAdd{0, (uint64_t)decoupledSignalDelta},
                 flagcxCoopBlock{});
    } else {
      net.put(world, peer, *recvMem, dstOffset, *sendMem, srcOffset, bytes,
              flagcxDevNet_SignalInc{0}, flagcxDevNet_None{},
              flagcxCoopBlock{});
    }
  }

  net.waitSignal(flagcxCoopBlock{}, 0,
                 initial +
                     (uint64_t)nRanks * (uint64_t)(decoupledSignalDelta != 0
                                                       ? decoupledSignalDelta
                                                       : 1));
  net.flush(flagcxCoopBlock{}, flagcxDeviceMemoryOrderAcqRel);
  xshmemPeBarrier(coop);
}

__global__ void flagcxXshmemCounterPipelineKernel(flagcxDevMem *sendMem,
                                                  flagcxDevMem *recvMem,
                                                  flagcxDevComm *devComm,
                                                  size_t count,
                                                  uint64_t *results) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  DeviceAPI::CoopBlock coop;
  flagcxDevNet net(*devComm, 0);
  flagcxTeam world = flagcxTeamWorld(*devComm);
  int rank = devComm->getRank();
  int nRanks = devComm->getSize();
  size_t bytes = count * sizeof(float);
  uint64_t initialSignal = net.readSignal(0);
  uint64_t initialCounter = net.readCounter(0);

  xshmemPeBarrier(coop);

  // Round 1 exercises a remote counter action and a local signal action.
  for (int peer = 0; peer < nRanks; ++peer) {
    net.put(world, peer, *recvMem, (size_t)rank * bytes, *sendMem,
            (size_t)peer * bytes, bytes, flagcxDevNet_CounterInc{0},
            flagcxDevNet_SignalInc{0}, flagcxCoopBlock{});
  }
  net.waitCounter(flagcxCoopBlock{}, 0, initialCounter + (uint64_t)nRanks);

  for (int peer = core_id(); peer < nRanks; peer += core_num()) {
    float *slot =
        (float *)flagcxGetLocalPointer(*sendMem, (size_t)peer * bytes);
    *slot = 999.0f;
  }
  mfence();
  xshmemPeBarrier(coop);

  for (int peer = 0; peer < nRanks; ++peer) {
    net.put(world, peer, *recvMem, (size_t)rank * bytes, *sendMem,
            (size_t)peer * bytes, bytes, flagcxDevNet_SignalInc{0},
            flagcxDevNet_CounterInc{0}, flagcxCoopBlock{});
  }
  net.waitCounter(flagcxCoopBlock{}, 0, initialCounter + 2 * (uint64_t)nRanks);
  net.waitSignal(flagcxCoopBlock{}, 0, initialSignal + 2 * (uint64_t)nRanks);
  net.flush(flagcxCoopBlock{}, flagcxDeviceMemoryOrderAcqRel);

  if (cluster_id() == 0 && core_id() == 0) {
    results[0] = net.readCounter(0) - initialCounter;
    results[1] = (uint64_t)nRanks;
  }
  xshmemPeBarrier(coop);
}

__global__ void flagcxXshmemSignalKernel(flagcxDevComm *devComm) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  DeviceAPI::CoopBlock coop;
  flagcxDevNet net(*devComm, 0);
  flagcxTeam world = flagcxTeamWorld(*devComm);
  int rank = devComm->getRank();
  int nRanks = devComm->getSize();
  uint64_t initial = net.readSignal(1);

  xshmemPeBarrier(coop);
  for (int peer = 0; peer < nRanks; ++peer) {
    if (peer != rank)
      net.signal(world, peer, flagcxDevNet_SignalInc{1}, flagcxCoopBlock{});
  }
  net.waitSignal(flagcxCoopBlock{}, 1, initial + (uint64_t)(nRanks - 1));
  net.flush(flagcxCoopBlock{}, flagcxDeviceMemoryOrderAcqRel);
  xshmemPeBarrier(coop);
}

__global__ void flagcxXshmemPutValueKernel(flagcxDevMem *recvMem,
                                           flagcxDevComm *devComm,
                                           size_t putValBase) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  DeviceAPI::CoopBlock coop;
  flagcxDevNet net(*devComm, 0);
  flagcxTeam world = flagcxTeamWorld(*devComm);
  int rank = devComm->getRank();
  int nRanks = devComm->getSize();
  uint64_t initial = net.readSignal(1);
  xshmemPeBarrier(coop);
  for (int peer = 0; peer < nRanks; ++peer) {
    uint64_t value = (uint64_t)rank * 1000u + (uint64_t)peer;
    net.putValue(world, peer, *recvMem,
                 putValBase + (size_t)rank * sizeof(uint64_t), value,
                 flagcxDevNet_SignalInc{1}, flagcxCoopBlock{});
  }
  net.waitSignal(flagcxCoopBlock{}, 1, initial + (uint64_t)nRanks);
  xshmemPeBarrier(coop);
}

__global__ void flagcxXshmemResetKernel(flagcxDevComm *devComm,
                                        uint64_t *results) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  flagcxDevNet net(*devComm, 0);
  if (cluster_id() == 0 && core_id() == 0) {
    net.resetSignal(0);
    net.resetSignal(1);
    net.resetSignal(2);
    net.resetCounter(0);
    results[0] = net.readSignal(0);
    results[1] = net.readSignal(1);
    results[2] = net.readSignal(2);
    results[3] = net.readCounter(0);
  }
}

__global__ void flagcxXshmemGetKernel(flagcxDevMem *sendMem,
                                      flagcxDevMem *recvMem,
                                      flagcxDevComm *devComm, size_t count) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  DeviceAPI::CoopBlock coop;
  flagcxDevNet net(*devComm, 0);
  flagcxTeam world = flagcxTeamWorld(*devComm);
  int rank = devComm->getRank();
  int nRanks = devComm->getSize();
  size_t bytes = count * sizeof(float);
  xshmemPeBarrier(coop);
  for (int peer = 0; peer < nRanks; ++peer) {
    net.get(world, peer, *sendMem, (size_t)rank * bytes, *recvMem,
            (size_t)peer * bytes, bytes, flagcxCoopBlock{});
  }
  xshmemPeBarrier(coop);
}

template <bool SplitBarrier>
__global__ void flagcxXshmemIntraPointerKernel(flagcxDevMem *devMem,
                                               flagcxDevComm *devComm,
                                               float *output, size_t count) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  int rank = devComm->getIntraRank();
  int peer = (rank + 1) % devComm->getIntraSize();
  flagcxTeam intra = flagcxTeamIntra(*devComm);
  flagcxDevBarrier<flagcxTeamTagIntra, flagcxCoopBlock> barrier{
      flagcxCoopBlock{}, *devComm, intra, 0};
  if (SplitBarrier) {
    barrier.arrive(flagcxDeviceMemoryOrderRelease);
    barrier.wait(flagcxDeviceMemoryOrderAcquire);
  } else {
    barrier.sync(flagcxDeviceMemoryOrderAcquire);
  }

  for (size_t i = (size_t)core_id(); i < count; i += (size_t)core_num()) {
    float *remote =
        (float *)flagcxGetIntraPointer(*devMem, i * sizeof(float), peer);
    if (remote)
      output[i] = *remote;
  }
  barrier.sync(flagcxDeviceMemoryOrderRelease);
}

__global__ void flagcxXshmemPeerPointerKernel(flagcxDevMem *devMem,
                                              flagcxDevComm *devComm,
                                              float *output, size_t count) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  int rank = devComm->getIntraRank();
  int peer = (rank + 1) % devComm->getIntraSize();
  flagcxTeam intra = flagcxTeamIntra(*devComm);
  for (size_t i = (size_t)core_id(); i < count; i += (size_t)core_num()) {
    float *remote =
        (float *)flagcxGetPeerPointer(*devMem, i * sizeof(float), intra, peer);
    if (remote)
      output[i] = *remote;
  }
}

__global__ void flagcxXshmemSymPtrKernel(flagcxDevMem *devMem,
                                         flagcxDevComm *devComm, int *results) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  if (cluster_id() == 0 && core_id() == 0) {
    int peer = (devComm->getIntraRank() + 1) % devComm->getIntraSize();
    flagcxSymPtr<float> ptr(*devMem, 0);
    flagcxSymPtr<float> advanced = ptr + 10;
    results[0] = ptr.localPtr() != nullptr && ptr.intraPtr(peer) != nullptr &&
                         advanced.offset - ptr.offset == 10 * sizeof(float) &&
                         advanced - ptr == 10
                     ? 1
                     : 0;
  }
}

__global__ void flagcxXshmemInterBarrierKernel(flagcxDevComm *devComm,
                                               int *results, int nIters) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  flagcxDevNet net(*devComm, 0);
  flagcxTeam inter = flagcxTeamInter(*devComm);
  flagcxDevBarrier<flagcxTeamTagInter, flagcxCoopBlock> barrier(
      flagcxCoopBlock{}, net, inter, 0);
  for (int i = 0; i < nIters; ++i)
    barrier.sync(flagcxDeviceMemoryOrderAcqRel);
  if (cluster_id() == 0 && core_id() == 0)
    results[0] = 1;
}

__global__ void flagcxXshmemWorldBarrierKernel(flagcxDevComm *devComm,
                                               int *results) {
  XSHMEM_DEVICE_INIT(devComm->_commBase.devStateHandle);
  flagcxDevNet net(*devComm, 0);
  flagcxDevBarrier<flagcxTeamTagWorld, flagcxCoopBlock> barrier(
      flagcxCoopBlock{}, flagcxTeamTagWorld{}, net, 0);
  barrier.sync(flagcxDeviceMemoryOrderAcqRel);
  if (cluster_id() == 0 && core_id() == 0)
    results[0] = 1;
}

flagcxResult_t launchKernelNetTwoSidedAlltoAll(
    flagcxDevMem_t sendMem, flagcxDevMem_t recvMem, size_t count,
    flagcxDataType_t datatype, flagcxDevComm_t devComm, flagcxStream_t stream) {
  STUB_UNUSED(sendMem);
  STUB_UNUSED(recvMem);
  STUB_UNUSED(count);
  STUB_UNUSED(datatype);
  STUB_UNUSED(devComm);
  STUB_UNUSED(stream);
  return flagcxNotSupported;
}

flagcxResult_t launchKernelNetPutSignalInc(flagcxDevMem_t sendMem,
                                           flagcxDevMem_t recvMem, size_t count,
                                           flagcxDataType_t datatype,
                                           flagcxDevComm_t devComm,
                                           flagcxStream_t stream) {
  if (!sendMem || !recvMem || !devComm || datatype != flagcxFloat32)
    return flagcxInvalidArgument;
  flagcxDevMem *deviceSend = nullptr;
  flagcxDevMem *deviceRecv = nullptr;
  flagcxDevComm *deviceComm = nullptr;
  flagcxResult_t result =
      flagcxDevMemGetDevicePtr(sendMem, (void **)&deviceSend);
  if (result == flagcxSuccess)
    result = flagcxDevMemGetDevicePtr(recvMem, (void **)&deviceRecv);
  if (result == flagcxSuccess)
    result = flagcxDevCommGetDevicePtr(devComm, (void **)&deviceComm);
  if (result != flagcxSuccess)
    return result;
  XPUStream cs = (XPUStream)(*(void **)stream);
  flagcxXshmemPutSignalKernel<<<1, FLAGCX_SIMT_WIDTH, cs>>>(
      deviceSend, deviceRecv, deviceComm, count, 0);
  return klxWait(cs, "put signal-inc kernel");
}

