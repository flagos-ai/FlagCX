// ---------------------------------------------------------------------------
// S21: flagcxDevPut followed by a separate signal — primary team + WORLD
// 12 combos: 3 coop kinds x 2 signal variants x 2 teams.
// ---------------------------------------------------------------------------
__global__ void kernelDevPutSignalWaitUnifiedS(const flagcxDevComm *gComm,
                                               const flagcxDevMem *gDst,
                                               const flagcxDevMem *gSrc,
                                               int *result, int bytes,
                                               bool useInter, unsigned skew,
                                               int selectedVariant) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst, src;
  GM2LM(gDst, &dst, sizeof(dst));
  GM2LM(gSrc, &src, sizeof(src));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  flagcxTestSignalDelay(worldRank, cluster_id(), skew);
  const auto slice = unifiedPayloadSlice((size_t)bytes, cluster_id());
  bool ok = true;

#define S21_COMBO(slot, teamKind, peer, coopKind, signalVariant)               \
  do {                                                                         \
    if (((slot) / 2) % 2 != selectedVariant)                                  \
      break;                                                                  \
    const uint64_t expected = (signalVariant) == FLAGCX_UNIFIED_IR_SIGNAL_INC  \
                                  ? (uint64_t)1                                \
                                  : (uint64_t)3;                               \
    if (!irPutCoopSupported(useInter, coopKind))                               \
      break;                                                                   \
    if (core_id() == 0)                                                        \
      flagcxDevResetSignal(                                                    \
          &comm, contextId,                                                    \
          (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)));       \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (irCoopActive(coopKind)) {                                              \
      size_t off = size_t(unifiedPayloadGroup((slot), 2)) * (size_t)bytes +   \
                   slice.offset;                                              \
      flagcxDevPut(&comm, &dst, off, &src, off, slice.bytes, teamKind, peer,  \
                   contextId, coopKind, flagcxDeviceScopeSystem,               \
                   flagcxDeviceMemoryOrderRelease);                            \
      if ((signalVariant) == FLAGCX_UNIFIED_IR_SIGNAL_INC)                     \
        flagcxDevSignalInc(                                                    \
            &comm, teamKind, peer,                                             \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),      \
            contextId, coopKind, flagcxDeviceScopeSystem);                     \
      else                                                                     \
        flagcxDevSignalAdd(                                                    \
            &comm, teamKind, peer,                                             \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),      \
            (uint64_t)3, contextId, coopKind, flagcxDeviceScopeSystem);        \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevWaitSignal(                                                       \
        &comm, (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),   \
        expected, 64, contextId, FLAGCX_COOP_BLOCK,                            \
        flagcxDeviceMemoryOrderAcquire);                                       \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(                                                   \
            &comm,                                                             \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)), 64,  \
            contextId, flagcxDeviceMemoryOrderAcquire) != (expected))          \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S21_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S21_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S21_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S21_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S21_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S21_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S21_COMBO(6, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S21_COMBO(7, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S21_COMBO(8, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S21_COMBO(9, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S21_COMBO(10, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S21_COMBO(11, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_ADD);

#undef S21_COMBO

  flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,
                 flagcxDeviceMemoryOrderRelaxed);

  if (core_id() == 0)
    result[cluster_id()] = ok ? 1 : 0;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevPutSignalWaitIntraWorldS(
    const void *devCommPtr, const void *dstMemPtr, const void *srcMemPtr,
    int *devResult, size_t bytes, flagcxStream_t stream, unsigned skew,
    int selectedVariant) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutSignalWaitUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      (const flagcxDevMem *)srcMemPtr, devResult, (int)bytes, false, skew,
      selectedVariant);
  irWait(cs, "S21 DevPutSignalWait");
}

