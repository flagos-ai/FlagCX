// ---------------------------------------------------------------------------
// S23: put variants with a sender-side counter — primary team + WORLD
// 18 combos: 3 coop kinds x 3 completion variants x 2 teams.
// variant 0: LCtrInc only, 1: RSigInc + LCtrInc, 2: RSigAdd(3) + LCtrInc.
// The counter is local, so it must reach exactly 1 per (context, counter).
// ---------------------------------------------------------------------------
enum {
  FLAGCX_UNIFIED_IR_PUT_LCTR_INC = 0,
  FLAGCX_UNIFIED_IR_PUT_RSIG_INC_LCTR_INC = 1,
  FLAGCX_UNIFIED_IR_PUT_RSIG_ADD_LCTR_INC = 2,
};

__global__ void kernelDevPutCounterUnifiedS(const flagcxDevComm *gComm,
                                            const flagcxDevMem *gDst,
                                            const flagcxDevMem *gSrc,
                                            int *result, int bytes,
                                            bool useInter, unsigned skew,
                                            int selectedVariant) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst, src;
  GM2LM(gDst, &dst, sizeof(dst));
  GM2LM(gSrc, &src, sizeof(src));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  flagcxTestSignalDelay(worldRank, cluster_id(), skew);
  const auto slice = unifiedPayloadSlice((size_t)bytes, cluster_id());
  bool ok = true;

#define S23_COMBO(slot, teamKind, peer, coopKind, variant)                     \
  do {                                                                         \
    if (((slot) / 2) % 3 != selectedVariant)                                  \
      break;                                                                  \
    if (!irPutCoopSupported(useInter, coopKind))                               \
      break;                                                                   \
    const flagcxDevCounter_t ctr =                                             \
        (flagcxDevCounter_t)unifiedCompletionId(cluster_id(), (slot));         \
    const flagcxDevSignal_t sig =                                              \
        (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot));          \
    if (core_id() == 0) {                                                      \
      flagcxDevResetCounter(&comm, contextId, ctr);                            \
      flagcxDevResetSignal(&comm, contextId, sig);                             \
      if (flagcxDevReadCounter(&comm, ctr, 64, contextId,                      \
                               flagcxDeviceMemoryOrderAcquire) != 0 ||         \
          flagcxDevReadSignal(&comm, sig, 64, contextId,                       \
                              flagcxDeviceMemoryOrderAcquire) != 0)            \
        ok = false;                                                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (irCoopActive(coopKind)) {                                              \
      size_t off = size_t(unifiedPayloadGroup((slot), 3)) * (size_t)bytes +   \
                   slice.offset;                                              \
      if (variant == 0)                                                        \
        flagcxDevPut_LCtrInc(&comm, &dst, off, &src, off, slice.bytes,        \
                             teamKind, peer, contextId, coopKind,              \
                             flagcxDeviceScopeSystem,                          \
                             flagcxDeviceMemoryOrderRelease, ctr);             \
      else if (variant == 1)                                                   \
        flagcxDevPut_RSigInc_LCtrInc(                                          \
            &comm, &dst, off, &src, off, slice.bytes, teamKind, peer,         \
            contextId, coopKind, flagcxDeviceScopeSystem,                      \
            flagcxDeviceMemoryOrderRelease, sig, ctr);                         \
      else                                                                     \
        flagcxDevPut_RSigAdd_LCtrInc(                                          \
            &comm, &dst, off, &src, off, slice.bytes, teamKind, peer,         \
            contextId, coopKind, flagcxDeviceScopeSystem,                      \
            flagcxDeviceMemoryOrderRelease, sig, (uint64_t)3, ctr);            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevWaitCounter(&comm, ctr, 1, 64, contextId, FLAGCX_COOP_BLOCK,      \
                         flagcxDeviceMemoryOrderAcquire);                      \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadCounter(&comm, ctr, 64, contextId,                        \
                             flagcxDeviceMemoryOrderAcquire) != 1)             \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    if (variant != 0) {                                                        \
      const uint64_t expectedSig = (variant == 1) ? 1 : 3;                     \
      flagcxDevWaitSignal(&comm, sig, expectedSig, 64, contextId,              \
                          FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcquire);  \
      if (core_id() == 0 &&                                                    \
          flagcxDevReadSignal(&comm, sig, 64, contextId,                       \
                              flagcxDeviceMemoryOrderAcquire) != expectedSig)  \
        ok = false;                                                            \
      flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                      \
    }                                                                          \
  } while (0)

  S23_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_PUT_LCTR_INC);
  S23_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_PUT_LCTR_INC);
  S23_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD,
            FLAGCX_UNIFIED_IR_PUT_RSIG_INC_LCTR_INC);
  S23_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD,
            FLAGCX_UNIFIED_IR_PUT_RSIG_INC_LCTR_INC);
  S23_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD,
            FLAGCX_UNIFIED_IR_PUT_RSIG_ADD_LCTR_INC);
  S23_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD,
            FLAGCX_UNIFIED_IR_PUT_RSIG_ADD_LCTR_INC);

  S23_COMBO(6, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP, FLAGCX_UNIFIED_IR_PUT_LCTR_INC);
  S23_COMBO(7, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_WARP, FLAGCX_UNIFIED_IR_PUT_LCTR_INC);
  S23_COMBO(8, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_PUT_RSIG_INC_LCTR_INC);
  S23_COMBO(9, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_PUT_RSIG_INC_LCTR_INC);
  S23_COMBO(10, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_PUT_RSIG_ADD_LCTR_INC);
  S23_COMBO(11, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_PUT_RSIG_ADD_LCTR_INC);

  S23_COMBO(12, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_PUT_LCTR_INC);
  S23_COMBO(13, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_PUT_LCTR_INC);
  S23_COMBO(14, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK,
            FLAGCX_UNIFIED_IR_PUT_RSIG_INC_LCTR_INC);
  S23_COMBO(15, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_BLOCK,
            FLAGCX_UNIFIED_IR_PUT_RSIG_INC_LCTR_INC);
  S23_COMBO(16, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK,
            FLAGCX_UNIFIED_IR_PUT_RSIG_ADD_LCTR_INC);
  S23_COMBO(17, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_BLOCK,
            FLAGCX_UNIFIED_IR_PUT_RSIG_ADD_LCTR_INC);

#undef S23_COMBO

  flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,
                 flagcxDeviceMemoryOrderRelaxed);

  if (core_id() == 0)
    result[cluster_id()] = ok ? 1 : 0;
}

