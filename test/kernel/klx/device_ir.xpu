// ---------------------------------------------------------------------------
// S24: flagcxDevPutValue_RSigInc / _RSigAdd — scalar write plus fused signal
// 12 combos: 3 coop kinds x 2 remote-signal variants x 2 teams.
// ---------------------------------------------------------------------------
__global__ void kernelDevPutValueRSigUnifiedS(const flagcxDevComm *gComm,
                                              const flagcxDevMem *gDst,
                                              int *result, bool useInter,
                                              unsigned skew) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst;
  GM2LM(gDst, &dst, sizeof(dst));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  flagcxTestSignalDelay(worldRank, cluster_id(), skew);
  bool ok = true;

#define S24_COMBO(slot, teamKind, peer, coopKind, signalVariant)               \
  do {                                                                         \
    const uint64_t expected = (signalVariant) == FLAGCX_UNIFIED_IR_SIGNAL_INC  \
                                  ? (uint64_t)1                                \
                                  : (uint64_t)3;                               \
    if (core_id() == 0) {                                                      \
      flagcxDevResetSignal(                                                    \
          &comm, contextId,                                                    \
          (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)));       \
      if (flagcxDevReadSignal(                                                 \
              &comm,                                                           \
              (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),    \
              64, contextId, flagcxDeviceMemoryOrderAcquire) != 0)             \
        ok = false;                                                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (irCoopActive(coopKind)) {                                              \
      size_t off = (size_t)(cluster_id() * 12 + (slot)) * sizeof(uint64_t);    \
      uint64_t val = (uint64_t)(worldRank * 100 + cluster_id() * 12 + (slot)); \
      if ((signalVariant) == FLAGCX_UNIFIED_IR_SIGNAL_INC)                     \
        flagcxDevPutValue_RSigInc(                                             \
            &comm, &dst, off, val, teamKind, peer, contextId, coopKind,        \
            flagcxDeviceScopeSystem, flagcxDeviceMemoryOrderRelease,           \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)));     \
      else                                                                     \
        flagcxDevPutValue_RSigAdd(                                             \
            &comm, &dst, off, val, teamKind, peer, contextId, coopKind,        \
            flagcxDeviceScopeSystem, flagcxDeviceMemoryOrderRelease,           \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),      \
            (uint64_t)3);                                                      \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevWaitSignal(                                                       \
        &comm, (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),   \
        expected, 64, contextId, FLAGCX_COOP_BLOCK,                            \
        flagcxDeviceMemoryOrderAcquire);                                       \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(                                                   \
            &comm,                                                             \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)), 64,  \
            contextId, flagcxDeviceMemoryOrderAcquire) != (expected))          \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S24_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S24_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S24_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S24_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S24_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S24_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S24_COMBO(6, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S24_COMBO(7, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP,
            FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S24_COMBO(8, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S24_COMBO(9, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_INC);
  S24_COMBO(10, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_ADD);
  S24_COMBO(11, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_BLOCK, FLAGCX_UNIFIED_IR_SIGNAL_ADD);

#undef S24_COMBO

  if (core_id() == 0)
    result[cluster_id()] = ok ? 1 : 0;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevPutValueRSigIntraWorldS(const void *devCommPtr,
                                            const void *dstMemPtr,
                                            int *devResult, size_t bytes,
                                            flagcxStream_t stream,
                                            unsigned skew) {
  (void)bytes; // every combo writes a single uint64_t
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutValueRSigUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      devResult, false, skew);
  irWait(cs, "S24 DevPutValue_RSig");
}

void launchKernelDevPutValueRSigInterWorldS(const void *devCommPtr,
                                            const void *dstMemPtr,
                                            int *devResult, size_t bytes,
                                            flagcxStream_t stream,
                                            unsigned skew) {
  (void)bytes;
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutValueRSigUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      devResult, true, skew);
  irWait(cs, "S24 DevPutValue_RSig INTER");
}
#endif

// ---------------------------------------------------------------------------
// S25: signal shadow + flush — primary team + WORLD
// The shadow is local: raise it by 5, send 5 increments to the ring peer, then
// wait until the received total meets the shadow.
// ---------------------------------------------------------------------------
__global__ void kernelDevSignalShadowFlushUnifiedS(const flagcxDevComm *gComm,
                                                   int *result, bool useInter,
                                                   unsigned skew) {
  FLAGCX_IR_PROLOGUE(gComm);

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  flagcxTestSignalDelay(worldRank, cluster_id(), skew);
  bool ok = true;

#define S25_COMBO(slot, teamKind, peer, coopKind)                              \
  do {                                                                         \
    if (core_id() == 0) {                                                      \
      flagcxDevResetSignal(                                                    \
          &comm, contextId,                                                    \
          (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)));       \
      if (flagcxDevReadSignal(                                                 \
              &comm,                                                           \
              (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),    \
              64, contextId, flagcxDeviceMemoryOrderAcquire) != 0)             \
        ok = false;                                                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (core_id() == 0) {                                                      \
      flagcxDevIncreaseSignalShadow(                                           \
          &comm, contextId,                                                    \
          (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),        \
          (uint64_t)5);                                                        \
      for (int i = 0; i < 5; i++)                                              \
        flagcxDevSignalInc(                                                    \
            &comm, teamKind, peer,                                             \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)),      \
            contextId, FLAGCX_COOP_THREAD, flagcxDeviceScopeSystem);           \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    if (irCoopActive(coopKind))                                                \
      flagcxDevWaitSignalMeetShadow(                                           \
          &comm, contextId,                                                    \
          (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)), 64,    \
          coopKind, flagcxDeviceMemoryOrderAcquire);                           \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(                                                   \
            &comm,                                                             \
            (flagcxDevSignal_t)unifiedCompletionId(cluster_id(), (slot)), 64,  \
            contextId, flagcxDeviceMemoryOrderAcquire) != 5)                   \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,                        \
                   flagcxDeviceMemoryOrderAcquire);                            \
  } while (0)

  S25_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD);
  S25_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD);
  S25_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP);
  S25_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP);
  S25_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK);
  S25_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_BLOCK);

#undef S25_COMBO

  if (core_id() == 0)
    result[cluster_id()] = ok ? 1 : 0;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevSignalShadowFlushIntraWorldS(const void *devCommPtr,
                                                 int *devResult,
                                                 flagcxStream_t stream,
                                                 unsigned skew) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevSignalShadowFlushUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES,
                                       cs>>>((const flagcxDevComm *)devCommPtr,
                                             devResult, false, skew);
  irWait(cs, "S25 DevSignalShadowFlush");
}

void launchKernelDevSignalShadowFlushInterWorldS(const void *devCommPtr,
                                                 int *devResult,
                                                 flagcxStream_t stream,
                                                 unsigned skew) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevSignalShadowFlushUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES,
                                       cs>>>((const flagcxDevComm *)devCommPtr,
                                             devResult, true, skew);
  irWait(cs, "S25 DevSignalShadowFlush INTER");
}
#endif

__global__ void kernelSignalTestContextCountS(const flagcxDevComm *gComm,
                                              int *result) {
  flagcxDevComm comm;
  GM2LM(gComm, &comm, sizeof(comm));
  if (cluster_id() == 0 && core_id() == 0)
    result[0] = comm.getContextCount();
}
#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelSignalTestContextCountS(const void *ptr, int *result,
                                         flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelSignalTestContextCountS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)ptr, result);
}

#endif
