ARG BASE_IMAGE=harbor.baai.ac.cn/flagos-runtime/flagos-runtime-kunlunxin-xre5.37.1:2.3.0@sha256:679182a04d187562a3e23bacb9d0eb876dabf09ac0c0a875c2b4a141b64cac69
ARG XTDK_IMAGE=ccr.ccs.tencentyun.com/taco/taco-train:kunlun_torch2.0.1-ubuntu20-04-py3.8-v1.0@sha256:7c39b3c4185d7755c5c3462db892beb860bf96395840bda8d18797731b4d4924
ARG XCCL_IMAGE=harbor.baai.ac.cn/flagscale/flagscale-train:dev-kunlun-py3.10-20260915@sha256:21bd3bea8582baf04820d0fa53c1792667c82aa97b11af80ab7c702cb7590700

FROM ${XTDK_IMAGE} AS xtdk
FROM ${XCCL_IMAGE} AS xccl
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libibverbs-dev \
        libnuma-dev \
        nlohmann-json3-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=xtdk /opt/xtdk/ /usr/local/xtdk-llvm15-ubuntu2004_x86_64/
COPY --from=xccl /opt/xccl_Linux_x86_64/ /opt/flagcx-sdk/xccl/

# XTDK 3.4.0.1 keeps device headers under its clang resource directory.
# Install the complete XCCL 3.1.7.0 SDK so its XSHMEM headers, host library,
# and libxshmem_device.a come from the same build. This SDK lists XTDK 3.7.0.1
# as a dependency; the available 3.4.0.1 compiler builds the test kernels,
# but full runtime compatibility has not been established.
RUN ln -s ../../lib/clang/15.0.7/include/xpu/kernel /usr/local/xtdk-llvm15-ubuntu2004_x86_64/include/xpu/kernel \
    && rm -rf /usr/local/xccl_Linux_x86_64 \
    && ln -s /opt/flagcx-sdk/xccl /usr/local/xccl_Linux_x86_64 \
    && ln -s /usr/local/xccl_Linux_x86_64 /usr/local/xccl

ENV XTDK_HOME=/usr/local/xtdk-llvm15-ubuntu2004_x86_64
ENV CCL_HOME=/usr/local/xccl_Linux_x86_64
ENV XCCL_HOME=/usr/local/xccl_Linux_x86_64
ENV PATH=/usr/local/xtdk-llvm15-ubuntu2004_x86_64/bin:/usr/local/mpich-3.3.2/bin:/usr/local/xpu/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/xccl_Linux_x86_64/so:/usr/local/mpich-3.3.2/lib:/usr/local/xpu/so:/usr/local/xpu/lib:${LD_LIBRARY_PATH}

RUN test -x "$XTDK_HOME/bin/clang++" \
    && test -r "$XTDK_HOME/include/xpu/kernel/xtdk.h" \
    && test -r "$CCL_HOME/include/xshmem/xshmem.h" \
    && test -r "$CCL_HOME/lib/libxshmem_device.a" \
    && "$XTDK_HOME/bin/clang++" --version \
    && printf '#include <xshmem/xshmem.h>\n' | g++ -I"$CCL_HOME/include" -I/usr/local/xpu/include -x c++ -fsyntax-only -
