/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Device-compiled helpers for Ascend/CANN Device API host integration.
 *
 * Exports the two symbols that flagcx/adaptor/device_api/default_dev_api_
 * backend.cc declares under COMPILE_KERNEL_HOST (see its :40-45 block):
 * without them the Default-backend host object does not resolve at link
 * time. The call site is :1422, which only enters this path when
 * flagcxDevNetSizeOf() returns non-zero.
 *
 * Shape follows flagcx/adaptor/kernel/iluvatar/device_api_host_helpers.cu:
 * neither the kernel nor its launch is split by a pass guard. bisheng
 * compiles one ASC translation unit into a host object that carries the
 * device image (.aicore_binary), and the launch has to survive into THAT
 * host half — flagcxDevNetLaunchConstruct is only ever called from host
 * code, so guarding it with __CCE_IS_AICORE__ (device pass only) would
 * leave the linked library with an empty body: a silent no-op.
 *
 * Why the kernel takes its buffers inside a by-value struct of unqualified
 * pointers instead of __gm__ pointer parameters. Every clause below is a
 * measurement on the 910C gate runs (6ae3e8f helpers, then the isolated
 * probe series of 2026-11-10), not an assumption:
 *   - a __global__ kernel's raw pointer parameter must carry a memory
 *     qualifier ("expecting parameter nets to have memory qualifier
 *     __gm__"), so the __gm__ spelling is mandatory for pointer params;
 *   - but once inside an aicore function no conversion between __gm__ and
 *     an unqualified pointer is available in either direction, implicit
 *     included:
 *       "cannot initialize a variable of type '__gm__ uint64_t *' with an
 *        lvalue of type 'uint64_t *'"            (probe B2)
 *       "cannot initialize a variable of type 'uint64_t *' with an lvalue
 *        of type '__gm__ uint64_t *'"            (probe B3)
 *     and bisheng has no __builtin_astype to opt out of (probe B4: the
 *     builtin is absent from this clang);
 *   - so a __gm__ array parameter can never be handed to the flagcxDevNet
 *     / flagcxDevComm types, whose pointer members are unqualified —
 *     device_utils.h:45-52 expands FLAGCX_DEVICE_GLOBAL_PTR to
 *     __global_ptr__ on Kunlunxin only — and a __gm__ object also cannot
 *     receive a construction: both the constructor call and the implicit
 *     copy assignment need their implicit this in Local Memory ("1st
 *     argument ('__gm__ flagcxDevComm') is in address space __gm__, but
 *     parameter must be in Local Memory");
 *   - passing the same pointers as VALUE inside a struct keeps them
 *     unqualified, and that shape both compiles and is semantically right:
 *     a kernel launched from the host half with a struct holding one
 *     unqualified uint32_t*, storing through it, and read back with
 *     aclrtMemcpy returned the stored values (probe RP, "OUT 10 11 0 0"),
 *     i.e. unqualified pointers do address global memory on this pass even
 *     though the mix flags carry
 *     -mllvm -cce-aicore-basicaa-disjoint-addrspace=true.
 * That is also the shape the backend itself uses: device_utils.h:62-66
 * documents flagcxDevComm / flagcxDevMem as by-value kernel parameters.
 *
 * No cast is needed at the launch boundary: an unqualified uint64_t* is
 * accepted where the parameter declares __gm__ uint64_t* (probe B5 compiled
 * and probe RG ran, "OUT 20 22 0 0"), which is why nothing below converts
 * a pointer type beyond void* -> the struct's own member type.
 *
 * Construction is a copy-assignment rather than a placement new because
 * bisheng has no device-callable non-allocating operator new; the
 * diagnostic survives including <new> and declaring the placement pair
 * locally in this file. That substitution is safe here specifically because
 * flagcxDevNet, its DeviceAPI::Net base and the Comm it copies hold only
 * scalars and device pointers, with no user-declared destructor, copy
 * constructor or assignment operator anywhere in default_comm_traits.h
 * (:691-796) / flagcx_device_core.h — i.e. the types are trivially copyable
 * and the memberwise copy writes exactly the bytes the constructor would.
 *
 * This file deliberately touches no atomic, no fence and no barrier: the
 * CCE scalar-atomic patterns are not selectable on this toolchain yet (see
 * ascend_platform_traits.h), and the Net constructor body it runs is pure
 * field copying plus one indexed read of dc.fifoBuffers[_contextId].
 ************************************************************************/

#include "device_api/flagcx_device_internal.h"
#include "device_api/flagcx_device_core.h"
#include <stddef.h>

extern "C" size_t flagcxDevNetSizeOf() { return sizeof(flagcxDevNet); }

// The buffers travel by value, unqualified — see the note above.
struct FlagcxDevNetBuildArgs {
  flagcxDevNet *nets;
  flagcxDevComm *comm;
};

// One AI core runs the whole construction loop: Ascend 910C gives the
// Default backend no usable lane model (see the measurements recorded in
// device_utils.h), so the launch is a single-block kernel and the count is
// walked serially. Stage 3 can raise the core count once the cross-core
// barrier story is settled.
__global__ __aicore__ void flagcxDevNetConstructKernel(
    FlagcxDevNetBuildArgs args, int count) {
  for (int i = 0; i < count; ++i) {
    args.nets[i] = flagcxDevNet(*args.comm, i);
  }
}

extern "C" void flagcxDevNetLaunchConstruct(void *devNets, void *devComm,
                                            int count, void *stream) {
  if (count <= 0 || devNets == nullptr || devComm == nullptr) return;
  FlagcxDevNetBuildArgs args;
  args.nets = reinterpret_cast<flagcxDevNet *>(devNets);
  args.comm = reinterpret_cast<flagcxDevComm *>(devComm);
  // Launch configuration verified on this toolchain: the second element is
  // the shared-memory descriptor slot (void*), the third the stream. The
  // stream stays a void* on purpose — aclrtStream is a typedef of void*,
  // and naming it here would drag acl/acl.h + hccl/hccl.h into a device
  // pass that does not need them.
  flagcxDevNetConstructKernel<<<1, (void *)0, (void *)stream>>>(args, count);
}
