/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Device-compiled helpers for Ascend/CANN Device API host integration.
 *
 * Exports the two symbols that flagcx/adaptor/device_api/default_dev_api_
 * backend.cc declares under COMPILE_KERNEL_HOST (see its :41-45 block):
 * without them the Default-backend host object does not resolve at link time.
 *
 * Shape follows flagcx/adaptor/kernel/iluvatar/device_api_host_helpers.cu:
 * neither the kernel nor its launch site is split by a pass guard. bisheng
 * compiles one ASC translation unit into a host object that carries the
 * device image (.aicore_binary), and the launch has to survive into THAT host
 * half — flagcxDevNetLaunchConstruct is only ever called from host code, so
 * guarding it with __CCE_IS_AICORE__ (device pass only) would leave the
 * linked library with an empty body: a silent no-op.
 *
 * Two spellings differ from the CUDA reference because bisheng enforces them
 * (both measured on the 910C gate run of commit 25e2cc7):
 *   - a __global__ kernel's pointer parameters must carry a memory qualifier:
 *       "expecting parameter nets to have memory qualifier __gm__"
 *     so both pointers below are __gm__, unlike nvcc, which accepts generic
 *     pointers for the same code;
 *   - libstdc++'s non-allocating operator new is not available in the
 *     __aicore__ execution space:
 *       "no matching 'operator new' function for non-allocating placement
 *        new expression; include <new>"
 *     even though <new> IS included below. nvcc ships device-side new
 *     overloads; bisheng has none, so the placement pair is declared here.
 ************************************************************************/

#include "device_api/flagcx_device_internal.h"
#include "device_api/flagcx_device_core.h"
#include <new>
#include <stddef.h>

extern "C" size_t flagcxDevNetSizeOf() { return sizeof(flagcxDevNet); }

#if defined(__CCE_IS_AICORE__)
// Non-allocating placement forms only: no CCE kernel here ever allocates. The
// matching delete forms exist so that a constructor that throws between the
// allocation and the end of its body is not a hard error in this TU (no CCE
// path allocates either way, so these never generate code).
__aicore__ inline void *operator new(size_t, void *place) noexcept {
  return place;
}
__aicore__ inline void *operator new[](size_t, void *place) noexcept {
  return place;
}
__aicore__ inline void operator delete(void *, void *) noexcept {}
__aicore__ inline void operator delete[](void *, void *) noexcept {}
#endif  // __CCE_IS_AICORE__

// One AI core runs the whole construction loop: Ascend 910C gives the Default
// backend no usable lane model (see device_utils.h for the measurements), so
// the launch is a single-block kernel and the count is walked serially. Stage
// 3 can raise the core count once the cross-core barrier story is settled.
__global__ __aicore__ void flagcxDevNetConstructKernel(
    __gm__ flagcxDevNet *nets, __gm__ flagcxDevComm *comm, int count) {
  for (int i = 0; i < count; ++i) {
    ::new (&nets[i]) flagcxDevNet(*comm, i);
  }
}

extern "C" void flagcxDevNetLaunchConstruct(void *devNets, void *devComm,
                                            int count, void *stream) {
  if (count <= 0 || devNets == nullptr || devComm == nullptr) return;
  // Launch configuration verified rc=0 on this toolchain: the second element
  // is the shared-memory descriptor slot (void*), the third the stream. The
  // stream stays a void* on purpose — aclrtStream is a typedef of void*, and
  // naming it here would drag acl/acl.h + hccl/hccl.h into a device pass that
  // does not need them. The two pointer arguments are cast to __gm__ because
  // that is what the kernel signature demands (see the header note).
  flagcxDevNetConstructKernel<<<1, (void *)0, (void *)stream>>>(
      static_cast<__gm__ flagcxDevNet *>(devNets),
      static_cast<__gm__ flagcxDevComm *>(devComm), count);
}
