/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Enflame/TOPS host-side helpers for the Device API and the collective-kernel
 * launcher.
 *
 * This is the counterpart of nvidia/du/iluvatar `device_api_host_helpers.cu`
 * plus the `flagcxLaunchCollectiveKernel` half of
 * `flagcx_reduce_kernel_device.cu`. Those files are compiled by the platform
 * device compiler and linked into libflagcx.so via PLATFORM_KERNEL_SRCS
 * (Makefile: `$(LIBDIR)/$(TARGET): $(LIBOBJ) $(DEVOBJS)`), so Enflame needs an
 * equivalent or the library ends up with undefined symbols.
 *
 * Why the symbols must exist at all -- note they are only *declared*, never
 * defined, elsewhere on this path:
 *   - `device_api/eccl_dev_api_backend.cc:22` is `#ifdef COMPILE_KERNEL_HOST`,
 *     so with COMPILE_KERNEL=1 the file keeps the two extern "C" declarations
 *     and calls, and drops its `static ... { return 0; }` fallbacks.
 *   - `runner/uni_runner_impl.cc:1871` calls flagcxLaunchCollectiveKernel
 *     under the same COMPILE_KERNEL_HOST guard.
 * A shared object may carry undefined symbols, so `make USE_ENFLAME=1
 * COMPILE_KERNEL=1` reports success and only the *test executable* link fails.
 *
 * With ECCL GIN now functional on TOPS, this file provides real
 * implementations of the device net helpers:
 *   * `flagcxDevNetSizeOf()` returns `sizeof(flagcxDevNet)`, enabling
 *     eccl_dev_api_backend.cc's guard
 *     `if (hostCopy._contextCount > 0 && flagcxDevNetSizeOf() > 0)` to
 *     allocate the net-array and call the construct launch.
 *   * `flagcxDevNetLaunchConstruct()` launches a TOPS kernel that
 *     placement-news `flagcxDevNet` objects into device memory.
 *   * `flagcxLaunchCollectiveKernel()` remains a no-op, matching KunlunXin
 *     (`kunlunxin/device_api_host_helpers.xpu`), whose comment records the same
 *     reasoning: the only call site is under COMPILE_KERNEL_HOST, and the
 *     platform schedules collectives from the host, so a no-op satisfies the
 *     link.
 ************************************************************************/

#include <cstddef>
#include <new>

#include "flagcx.h" // flagcxStream_t
#include "device_api/flagcx_device_internal.h"
#include "device_api/flagcx_device_core.h"
#include "device_utils.h" // FLAGCX_DEVICE_HAS_PLACEMENT_NEW
#include <tops/tops_runtime.h>

extern "C" size_t flagcxDevNetSizeOf() { return sizeof(flagcxDevNet); }

static __global__ void flagcxDevNetConstructKernel(flagcxDevNet *nets,
                                                   flagcxDevComm *comm,
                                                   int count) {
  int i = FLAGCX_THREAD_IDX_X + FLAGCX_BLOCK_IDX_X * FLAGCX_BLOCK_DIM_X;
  if (i < count) {
#if FLAGCX_DEVICE_HAS_PLACEMENT_NEW
    ::new (&nets[i]) flagcxDevNet(*comm, i);
#else
    // TOPS device compiler does not support placement new; use copy-assign
    // instead. flagcxDevNet is trivially copyable, so the observable result
    // is the same value in the same storage.
    nets[i] = flagcxDevNet(*comm, i);
#endif
  }
}

extern "C" void flagcxDevNetLaunchConstruct(void *devNets, void *devComm,
                                            int count, void *stream) {
  if (count <= 0 || devNets == nullptr || devComm == nullptr)
    return;

  int threads = (count < 256) ? count : 256;
  int blocks = (count + threads - 1) / threads;

  topsLaunchConfig_t cfg = {};
  cfg.gridDim = {(unsigned int)blocks, 1, 1};
  cfg.blockDim = {(unsigned int)threads, 1, 1};
  if (stream != nullptr) {
    cfg.stream = *(topsStream_t *)stream;
  }
  // else cfg.stream remains 0 (default stream) from zero-initialization

  // Thread dimension is passed as a launch attribute on TOPS
  topsLaunchAttribute attr[2];
  attr[0].id = topsLaunchAttributeThreadDimension;
  attr[0].val.threadDim = {(unsigned int)threads, 1, 1};
  attr[1].id = topsLaunchAttributeCooperative;
  attr[1].val.cooperative = 0; // Non-cooperative launch for construction
  cfg.attrs = attr;
  cfg.numAttrs = 2;

  flagcxDevNet *netsArg = (flagcxDevNet *)devNets;
  flagcxDevComm *commArg = (flagcxDevComm *)devComm;
  int countArg = count;
  void *kernelArgs[] = {&netsArg, &commArg, &countArg};

  topsLaunchKernelExC(&cfg, (const void *)flagcxDevNetConstructKernel,
                      kernelArgs);
}

// Declared in flagcx/include/flagcx_kernel_internal.h:61 with plain C++
// linkage (no extern "C"), so the parameter list must match exactly for the
// mangled name to line up with the call in uni_runner_impl.cc:1873.
void flagcxLaunchCollectiveKernel(void *fifoBuffer, size_t nthreads,
                                  size_t nblocks, flagcxStream_t stream) {
  (void)fifoBuffer;
  (void)nthreads;
  (void)nblocks;
  (void)stream;
}
