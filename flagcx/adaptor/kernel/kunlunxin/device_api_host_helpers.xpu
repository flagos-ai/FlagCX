/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * XPU-compiled ABI checks and size queries for host/device materialization.
 *
 * Host-only: the layout checks compare the host-compiled flagcxShmemCommInternal
 * against the host-compiled Comm (where __global_ptr__ is empty, so pointer
 * widths match). The xpu3 device pass has a 32-bit size_t and __global_ptr__
 * address-space pointers, which changes sizeof/offsetof and makes these checks
 * meaningless — the same reason device_async_kernel.xpu is excluded from the
 * library build. Guard the whole body to the host pass so the device pass is an
 * empty TU.
 ************************************************************************/

#if defined(__xpu_on_host__) || !defined(__xpu__)

#include <cstddef>

#include "device_api/flagcx_device.h"
#include "xshmem_adaptor.h"

using XshmemComm = CommTraits<XshmemBackend>::Comm;

static_assert(sizeof(flagcxShmemCommInternal) == sizeof(XshmemComm),
              "xSHMEM communicator host/device layout mismatch");
static_assert(alignof(flagcxShmemCommInternal) == alignof(XshmemComm),
              "xSHMEM communicator host/device alignment mismatch");
static_assert(offsetof(flagcxShmemCommInternal, rank) ==
                  offsetof(XshmemComm, rank),
              "xSHMEM communicator rank offset mismatch");
static_assert(offsetof(flagcxShmemCommInternal, signalBuffer) ==
                  offsetof(XshmemComm, signalBuffer),
              "xSHMEM communicator signal offset mismatch");
static_assert(offsetof(flagcxShmemCommInternal, counterBuffer) ==
                  offsetof(XshmemComm, counterBuffer),
              "xSHMEM communicator counter offset mismatch");
static_assert(offsetof(flagcxShmemCommInternal, gridSyncState) ==
                  offsetof(XshmemComm, gridSyncState),
              "xSHMEM communicator grid-state offset mismatch");
static_assert(offsetof(flagcxShmemCommInternal, devStateHandle) ==
                  offsetof(XshmemComm, devStateHandle),
              "xSHMEM communicator final-field offset mismatch");
extern "C" size_t flagcxXshmemDevCommSizeOf() { return sizeof(flagcxDevComm); }

extern "C" size_t flagcxXshmemDevMemSizeOf() { return sizeof(flagcxDevMem); }

extern "C" size_t flagcxXshmemDevNetSizeOf() { return sizeof(flagcxDevNet); }

// KLX stub for the collective-kernel launcher. On P800 there is no
// flagcxCollectiveKernel device implementation (only nvidia/du provide one), so
// runUniRunner's COMPILE_KERNEL_HOST call would leave an undefined reference in
// libflagcx.so. KLX runs its collectives through the host scheduling loop, so a
// no-op satisfies the link.
void flagcxLaunchCollectiveKernel(void *fifoBuffer, size_t nthreads,
                                  size_t nblocks, flagcxStream_t stream) {
  (void)fifoBuffer;
  (void)nthreads;
  (void)nblocks;
  (void)stream;
}

#endif
